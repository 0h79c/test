  <Item class="ServerScriptService" referent="RBX5460">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX5461">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX5471">
        <Properties>
          <string name="Name">Character</string>
          <ProtectedString name="Source">local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local AnimalModels = require(game.ReplicatedStorage.Shared.AnimalModels)

local Character = {}
local active = {}
local initialized = false

local function disconnect(character)
 local state = active[character]
 if not state then return end
 for _, connection in ipairs(state.Connections) do connection:Disconnect() end
 active[character] = nil
end

function Character.Initialize()
 if not initialized then
  if not PhysicsService:IsCollisionGroupRegistered("EvolutionAvatar") then
   PhysicsService:RegisterCollisionGroup("EvolutionAvatar")
  end
  PhysicsService:CollisionGroupSetCollidable("EvolutionAvatar", "Default", false)
  PhysicsService:CollisionGroupSetCollidable("EvolutionAvatar", "EvolutionAvatar", false)
  initialized = true
 end
 return AnimalModels.EnsureLibrary()
end

local function belongsToAnimal(instance, character)
 local ancestor = instance.Parent
 while ancestor and ancestor ~= character do
  if ancestor:GetAttribute("EvolutionVisual") then return true end
  ancestor = ancestor.Parent
 end
 return false
end

local function hideAvatar(instance, character)
 if instance.Name == "AnimalCollider" or belongsToAnimal(instance, character) then return end
 if instance:IsA("BasePart") then
  instance.Transparency = 1
  instance.CanCollide = false
  instance.CanTouch = false
  instance.CanQuery = false
  -- Humanoid floor sensing uses its root's collision group. The root remains
  -- query-compatible with the map even though it never physically collides.
  instance.CollisionGroup = instance.Name == "HumanoidRootPart" and "Default" or "EvolutionAvatar"
  instance.Massless = instance.Name ~= "HumanoidRootPart"
 elseif instance:IsA("Decal") or instance:IsA("Texture") then
  instance.Transparency = 1
 elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") then
  instance.Enabled = false
 end
end

local function emitter(parent, name, color, rate, speed)
 local attachment = Instance.new("Attachment")
 attachment.Name = name
 attachment.Parent = parent
 local particles = Instance.new("ParticleEmitter")
 particles.Name = name .. "Particles"
 particles.Color = ColorSequence.new(color)
 particles.LightEmission = 0.55
 particles.LightInfluence = 0.15
 particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
 particles.Rate = rate
 particles.Lifetime = NumberRange.new(0.6, 1.25)
 particles.Speed = NumberRange.new(speed * 0.4, speed)
 particles.SpreadAngle = Vector2.new(55, 55)
 particles.Rotation = NumberRange.new(-180,180)
 particles.RotSpeed = NumberRange.new(-30,30)
 particles.Size = NumberSequence.new({
  NumberSequenceKeypoint.new(0, 0.06),
  NumberSequenceKeypoint.new(0.35, 0.17),
  NumberSequenceKeypoint.new(1, 0),
 })
 particles.Transparency = NumberSequence.new({
  NumberSequenceKeypoint.new(0, 0.5),
  NumberSequenceKeypoint.new(0.25, 0.2),
  NumberSequenceKeypoint.new(1, 1),
 })
 particles.Parent = attachment
 return attachment
end

local function auraRing(visual, radius, height, color, layer)
 for n=1,18 do
  local angle = n*math.pi*2/18
  local part = Instance.new("Part")
  part.Name = "MutationAuraRing"
  part.Size = Vector3.new(.035,.035,radius*.37)
  part.CFrame = CFrame.new(math.sin(angle)*radius,height,math.cos(angle)*radius)
   * CFrame.Angles(0,angle+math.pi/2,0)
  part.Color = color
  part.Material = Enum.Material.Neon
  part.Transparency = layer == 1 and .35 or .65
  part.Anchored = true
  part.CanCollide = false
  part.CanTouch = false
  part.CanQuery = false
  part.CastShadow = false
  part:SetAttribute("Motion","AuraRing")
  part:SetAttribute("Phase",layer == 1 and 1 or -1)
  part:SetAttribute("MotionPivot",Vector3.new(0,height,0))
  part.Parent = visual
 end
end

local function decorateAura(visual, definition, mutation, palette)
 if mutation.Name == "Normal" then return end
 local root = visual.PrimaryPart
 local rate = mutation.Name == "Awakened" and 16 or mutation.Name == "Radioactive" and 12 or 6
 local attachment = emitter(root,"MutationAura",palette.Aura,rate,1.05)
 attachment.Position = Vector3.new(0,definition.Collider[2]*.48,0)
 if mutation.Name == "Awakened" or mutation.Name == "Radioactive" then
  local radius = math.max(.85,definition.Collider[1]*.6)
  auraRing(visual,radius,.09,palette.Aura,1)
  if mutation.Name == "Awakened" then auraRing(visual,radius*1.17,.13,Color3.fromRGB(164,228,235),2) end
  local light = Instance.new("PointLight")
  light.Name = "MutationLight"
  light.Color = palette.Aura
  light.Brightness = mutation.Name == "Awakened" and .6 or .4
  light.Range = 7
  light.Shadows = false
  light.Parent = root
 end
 local highlight = Instance.new("Highlight")
 highlight.Name = "MutationOutline"
 highlight.Adornee = visual
 highlight.FillColor = palette.Aura
 highlight.FillTransparency = 1
 highlight.OutlineColor = palette.Aura
 highlight.OutlineTransparency = mutation.Name == "Awakened" and .38 or .72
 highlight.DepthMode = Enum.HighlightDepthMode.Occluded
 highlight.Parent = visual
end

function Character.Apply(player, data)
 local character = player.Character
 if not character then return false end
 local humanoid = character:FindFirstChildOfClass("Humanoid")
 local root = character:FindFirstChild("HumanoidRootPart")
 if not humanoid or not root then return false end
 if not initialized then Character.Initialize() end
 data = data or {}
 local form = math.clamp(math.floor(tonumber(data.Form) or 1), 1, #Config.Species)
 local mutations = typeof(data.Mutations) == "table" and data.Mutations or {}
 local species = Config.Species[form]
 local mutation = Config.Mutation(mutations[tostring(form)])
 local definition = AnimalModels.Definitions[form]

 disconnect(character)
 for _, name in ipairs({"AnimalVisual", "AnimalCollider", "GlideForce", "GlideAttachment", "AuraAttachment"}) do
  local old = character:FindFirstChild(name, true)
  if old then old:Destroy() end
 end

 -- Preserve the Roblox control rig for both R6 and R15. Only the single
 -- collider touches the world; decorative geometry never blocks jumps.
 humanoid.UseJumpPower = true
 humanoid.WalkSpeed = species.WalkSpeed * mutation.Speed
 humanoid.JumpPower = species.JumpPower * mutation.Jump
 humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
 humanoid.AutoRotate = true
 local groundHeight
 if humanoid.RigType == Enum.HumanoidRigType.R6 then
  humanoid.HipHeight = 0
  local leg = character:FindFirstChild("Left Leg")
  groundHeight = root.Size.Y / 2 + (leg and leg.Size.Y or 2)
 else
  humanoid.HipHeight = 2
  groundHeight = root.Size.Y / 2 + humanoid.HipHeight
 end
 for _, instance in ipairs(character:GetDescendants()) do hideAvatar(instance, character) end

 local scale = mutation.Scale
 scale = math.clamp(scale, 0.3, 1.5)
 local collision = definition.Collider
 local colliderSize = Vector3.new(
  math.clamp(collision[1] * scale, 0.95, 3.8),
  math.clamp(collision[2] * scale, 0.7, 4.1),
  math.clamp(collision[3] * scale, 1.4, 4.4)
 )
 humanoid.CameraOffset = Vector3.new(0,-groundHeight+math.max(.7,colliderSize.Y*.6),0)
 local collider = Instance.new("Part")
 collider.Name = "AnimalCollider"
 collider.Size = colliderSize
 collider.Transparency = 1
 collider.CanCollide = true
 collider.CanTouch = true
 collider.CanQuery = true
 collider.CollisionGroup = "Default"
 collider.Massless = true
 collider.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.35, 0, 1, 1)
 collider.CFrame = root.CFrame * CFrame.new(0, -groundHeight + colliderSize.Y / 2, 0)
 collider.Parent = character
 local colliderWeld = Instance.new("WeldConstraint")
 colliderWeld.Part0 = root
 colliderWeld.Part1 = collider
 colliderWeld.Parent = collider

 local visual = AnimalModels.Create(form)
 visual.Name = "AnimalVisual"
 visual:SetAttribute("EvolutionVisual", true)
 local palette = AnimalModels.ApplySkin(visual,form,mutation.Name)
 decorateAura(visual,definition,mutation,palette)
 visual:ScaleTo(scale)
 visual:PivotTo(root.CFrame * CFrame.new(0, -groundHeight, 0))
 visual.Parent = character
 AnimalModels.Rig(visual,root)

 local nameplate = Instance.new("BillboardGui")
 nameplate.Name = "SpeciesNameplate"
 nameplate.Size = UDim2.fromOffset(240, 44)
 nameplate.StudsOffset = Vector3.new(0, math.max(1.8, visual:GetExtentsSize().Y - groundHeight + 0.9), 0)
 nameplate.MaxDistance = 85
 nameplate.AlwaysOnTop = false
 nameplate.Adornee = root
 nameplate.Parent = visual
 local label = Instance.new("TextLabel")
 label.Size = UDim2.fromScale(1, 1)
 label.BackgroundTransparency = 1
 label.Text = species.Name .. " · " .. mutation.Label
 label.TextColor3 = palette.Aura or Color3.fromRGB(255,255,255)
 label.TextStrokeTransparency = 0.35
 label.TextStrokeColor3 = Color3.fromRGB(26, 40, 53)
 label.Font = Enum.Font.GothamBold
 label.TextSize = 14
 label.Parent = nameplate

 if form == 14 then
  local tail = visual:FindFirstChild("TailEmber") or visual.PrimaryPart
  emitter(tail, "PhoenixFlame", Color3.fromRGB(255, 174, 45), 10, 1.1)
  local light = Instance.new("PointLight")
  light.Color = Color3.fromRGB(255, 154, 46)
  light.Brightness = .6
  light.Range = 7
  light.Parent = tail
 end

 local glideForce
 if form &gt;= 13 or mutation.Name == "Awakened" then
  local attachment = Instance.new("Attachment")
  attachment.Name = "GlideAttachment"
  attachment.Parent = root
  glideForce = Instance.new("VectorForce")
  glideForce.Name = "GlideForce"
  glideForce.Attachment0 = attachment
  glideForce.RelativeTo = Enum.ActuatorRelativeTo.World
  glideForce.ApplyAtCenterOfMass = true
  glideForce.Force = Vector3.zero
  glideForce.Parent = root
 end

 local state = {Connections={}}
 active[character] = state
 table.insert(state.Connections, character.DescendantAdded:Connect(function(instance)
  hideAvatar(instance, character)
 end))
 local glideClock = 0
 table.insert(state.Connections, RunService.Heartbeat:Connect(function(dt)
  if character.Parent == nil or humanoid.Health &lt;= 0 then
   if glideForce then glideForce.Force = Vector3.zero end
   return
  end
  glideClock += dt
  if glideClock &lt; 0.1 then return end
  glideClock = 0
  local falling = humanoid:GetState() == Enum.HumanoidStateType.Freefall and root.AssemblyLinearVelocity.Y &lt; -2
  if glideForce then
   glideForce.Force = falling and Vector3.new(0, root.AssemblyMass * workspace.Gravity * 0.28, 0) or Vector3.zero
  end
 end))
 table.insert(state.Connections, character.AncestryChanged:Connect(function(_, parent)
  if not parent then disconnect(character) end
 end))
 character:SetAttribute("Form", form)
 character:SetAttribute("Mutation", mutation.Name)
 character:SetAttribute("MorphReady", true)
 character:SetAttribute("VisualScale", scale)
 return true
end

function Character.Cleanup(character)
 disconnect(character)
end

return Character
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5472">
        <Properties>
          <string name="Name">Commerce</string>
          <ProtectedString name="Source">-- Roblox purchases are fulfilled only by ProcessReceipt and a durable profile
-- transaction supplied by Main. Product/Pass ID 0 means intentionally disabled.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.EventRules)
local Commerce = {}
local callbacks = {}
local owned, querying, receiptsInFlight = {}, {}, {}
local started = false
local passPrice, dropPrice

local function ids()
 local settings = Config.Commerce or {}
 return settings.PassId or 0, settings.SupplyDropProductId or 0
end
local function message(player, text)
 if callbacks.Message and player and player.Parent then callbacks.Message(player, text) end
end
local function notifyPass(player, hasPass)
 owned[player] = hasPass == true
 if callbacks.OnPassChanged and player.Parent then callbacks.OnPassChanged(player, owned[player]) end
end
local function lookupPrice(id, infoType)
 if not Rules.IsValidMarketplaceId(id) then return nil end
 local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id, infoType) end)
 if ok and typeof(info) == "table" and typeof(info.PriceInRobux) == "number" then
  return info.PriceInRobux
 end
 return nil
end

function Commerce.HasPass(player)
 return owned[player] == true
end
function Commerce.GetBenefits(player)
 return Rules.PassBenefits(Commerce.HasPass(player))
end
function Commerce.GetAvailability(player)
 local passId, dropId = ids()
 return {
  PassAvailable = Rules.IsValidMarketplaceId(passId),
  DropAvailable = Rules.IsValidMarketplaceId(dropId),
  PassOwned = Commerce.HasPass(player), PassPrice = passPrice, DropPrice = dropPrice,
  DisabledReason = "Chưa cấu hình ID Roblox. Chủ game cần tạo Game Pass / Developer Product.",
 }
end
function Commerce.OnPlayerAdded(player)
 if querying[player] or owned[player] ~= nil then return end
 local passId = ids()
 if not Rules.IsValidMarketplaceId(passId) or player.UserId &lt;= 0 then
  notifyPass(player, false)
  return
 end
 querying[player] = true
 task.spawn(function()
  local ok, result = pcall(function()
   return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
  end)
  querying[player] = nil
  if not player.Parent then return end
  -- A confirmed purchase may arrive while the query yields. Never overwrite it
  -- with a stale false result. A failed query grants no paid entitlement.
  if owned[player] == true then return end
  if ok then notifyPass(player, result == true)
  else
   owned[player] = nil
   if callbacks.OnPassChanged then callbacks.OnPassChanged(player, false) end
   message(player, "Chưa kiểm tra được Game Pass; mở lại cửa hàng để thử lại.")
  end
 end)
end
function Commerce.PromptPass(player)
 local passId = ids()
 if not Rules.IsValidMarketplaceId(passId) then
  message(player, "Gói hỗ trợ đang chờ chủ game cấu hình ID Game Pass.")
  return false
 end
 if Commerce.HasPass(player) then message(player, "Bạn đã sở hữu gói hỗ trợ."); return false end
 Commerce.OnPlayerAdded(player)
 local ok = pcall(function() MarketplaceService:PromptGamePassPurchase(player, passId) end)
 if not ok then message(player, "Không mở được cửa hàng Roblox. Vui lòng thử lại.") end
 return ok
end
function Commerce.PromptSupplyDrop(player)
 local _, productId = ids()
 if not Rules.IsValidMarketplaceId(productId) then
  message(player, "Thính mua bằng Robux đang chờ cấu hình Developer Product.")
  return false
 end
 -- Unavailable persistence must never lead to charging without a durable award.
 if callbacks.CanPurchaseDrop and not callbacks.CanPurchaseDrop(player) then
  message(player, "Lưu dữ liệu chưa sẵn sàng; mua thính sẽ mở lại khi có thể lưu an toàn.")
  return false
 end
 local ok = pcall(function() MarketplaceService:PromptProductPurchase(player, productId) end)
 if not ok then message(player, "Không mở được cửa hàng Roblox. Vui lòng thử lại.") end
 return ok
end

function Commerce.Start(options)
 if started then return end
 started = true
 callbacks = options or {}
 MarketplaceService.ProcessReceipt = function(receipt)
  local _, productId = ids()
  local player = Players:GetPlayerByUserId(receipt.PlayerId)
  local purchaseId = receipt.PurchaseId
  if Rules.ReceiptDecision(receipt.ProductId, productId, player ~= nil, true) ~= "PurchaseGranted"
   or typeof(purchaseId) ~= "string" or purchaseId == "" or #purchaseId &gt; 200
   or not callbacks.GrantDropCredit or receiptsInFlight[purchaseId] then
   return Enum.ProductPurchaseDecision.NotProcessedYet
  end
  receiptsInFlight[purchaseId] = true
  local ok, granted = pcall(callbacks.GrantDropCredit, player, purchaseId)
  receiptsInFlight[purchaseId] = nil
  if not ok then warn("Supply drop receipt persistence failed", receipt.PlayerId) end
  if Rules.ReceiptDecision(receipt.ProductId, productId, player ~= nil, ok and granted == true) == "PurchaseGranted" then
   -- Main queues persisted credits after granting, including when the player
   -- reconnects. This hook is optional; replayed receipts cannot add credits.
   if callbacks.OnDropCreditGranted then task.defer(callbacks.OnDropCreditGranted, player) end
   return Enum.ProductPurchaseDecision.PurchaseGranted
  end
  return Enum.ProductPurchaseDecision.NotProcessedYet
 end
 MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, purchasedId, wasPurchased)
  local passId = ids()
  if wasPurchased and Rules.IsValidMarketplaceId(passId) and purchasedId == passId then
   notifyPass(player, true)
   message(player, "Đã kích hoạt gói hỗ trợ: +50% độ no và Coins, 2 reroll miễn phí mỗi món đột biến, hồi sinh gần mỗi 3 phút.")
  end
 end)
 Players.PlayerRemoving:Connect(function(player) owned[player] = nil; querying[player] = nil end)
 task.spawn(function()
  local passId, dropId = ids()
  passPrice = lookupPrice(passId, Enum.InfoType.GamePass)
  dropPrice = lookupPrice(dropId, Enum.InfoType.Product)
  if callbacks.OnAvailabilityChanged then callbacks.OnAvailabilityChanged() end
 end)
end

return Commerce
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5473">
        <Properties>
          <string name="Name">Ecology</string>
          <ProtectedString name="Source">-- Food ownership and wildlife run on the server. The client never supplies rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage.Shared.Config)
local FoodModels = require(ReplicatedStorage.Shared.FoodModels)
local AnimalModels = require(ReplicatedStorage.Shared.AnimalModels)

local Ecology = {ActiveFoods={}, ActiveNPCs={}}
local world, callbacks, rng, foodFolder, npcFolder, heartbeat
local generation, npcSerial, elapsed = 0, 0, 0
local EAT_RANGE = 8

local function horizontalDistance(a, b)
 local dx, dz = a.X - b.X, a.Z - b.Z
 return math.sqrt(dx * dx + dz * dz)
end

local function playerRoot(player)
 local character = player and player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health &lt;= 0 then return nil end
 if callbacks.CanEat and not callbacks.CanEat(player) then return nil end
 return root
end

-- The vertical allowance covers tall evolved animals; reach on the ground is eight studs.
function Ecology.InEatingRange(from, to)
 return horizontalDistance(from, to) &lt;= EAT_RANGE and math.abs(from.Y - to.Y) &lt;= 18
end

function Ecology.CanEatNPC(playerForm, npcForm, playerSize, npcSize)
 local function positiveFinite(value)
  return type(value) == "number" and value &gt; 0 and value &lt; math.huge
 end
 -- A large mutation can hunt physically smaller wildlife even at the same tier.
 -- If sizes were supplied, malformed or incomplete sizes never permit a hunt.
 if playerSize ~= nil or npcSize ~= nil then
  return positiveFinite(playerSize) and positiveFinite(npcSize) and playerSize &gt; npcSize
 end
 return positiveFinite(playerForm) and positiveFinite(npcForm) and playerForm &gt; npcForm
end

function Ecology.Claim(registry, model)
 local entry = registry[model]
 if not entry or entry.Claimed or not model.Parent then return nil end
 entry.Claimed = true
 registry[model] = nil -- Remove before callbacks, which may yield while granting rewards.
 return entry
end

local function foodSpecs()
 return Config.Foods or {
  {Id="berries", Name="Chùm mọng", Hunger=.5, Coins=2, Weight=23},
  {Id="leaf", Name="Lá non", Hunger=1, Coins=3, Weight=22},
  {Id="apple", Name="Táo chín", Hunger=2, Coins=5, Weight=20},
  {Id="mushroom", Name="Nấm rừng", Hunger=3, Coins=8, Weight=15},
  {Id="fish", Name="Cá bạc", Hunger=5, Coins=12, Weight=9},
  {Id="meat", Name="Thịt tươi", Hunger=7, Coins=18, Weight=7},
  {Id="fruit", Name="Quả nhiệt đới", Hunger=10, Coins=25, Weight=4},
 }
end

local function mutationSpec()
 return Config.MutationFood or {Id="mutation", Name="Quả đột biến", Hunger=3, Coins=35, Mutation=true}
end

function Ecology.RollFood(random, biome)
 if random:NextNumber() &lt; (Config.MutationFoodSpawnChance or .012) then return mutationSpec() end
 local eligible, total = {}, 0
 for _, spec in ipairs(foodSpecs()) do
  if not spec.Biomes or table.find(spec.Biomes, biome) then
   local weight = spec.Weight or 1
   if weight &gt; 0 then
    total += weight
    table.insert(eligible, spec)
   end
  end
 end
 if #eligible == 0 then return foodSpecs()[1] end
 local roll = random:NextNumber(0, total)
 for _, spec in ipairs(eligible) do
  roll -= spec.Weight or 1
  if roll &lt;= 0 then return spec end
 end
 return eligible[#eligible]
end

local function isMutation(spec)
 return spec.Mutation == true or spec.Id == "mutation"
end

local function reserved(position)
 for _, entry in pairs(Ecology.ActiveFoods) do
  if horizontalDistance(position, entry.Position) &lt; (Config.FoodMinimumSpacing or 70) then return true end
 end
 return false
end

local function spawnPosition(biome)
 for _ = 1, 45 do
  local position = world.RandomPosition(biome, rng)
  if position and not reserved(position) then return position end
 end
 return nil
end

local spawnFood
local function respawnFood(entry)
 local currentGeneration = generation
 local waitTime = isMutation(entry.Spec) and rng:NextNumber(120, 300) or rng:NextNumber(35, 90)
 local function attempt()
  if generation ~= currentGeneration then return end
  local position = spawnPosition(entry.Biome)
  if not position then position = world.GroundPosition(entry.GroundPosition) end
  if position and not reserved(position) then
   spawnFood(position, entry.Biome, Ecology.RollFood(rng, entry.Biome))
  else
   -- Every attempt is bounded; a temporarily crowded habitat must not lose a
   -- food slot permanently or bypass safe terrain/spacing to fill that slot.
   task.delay(15, attempt)
  end
 end
 task.delay(waitTime, attempt)
end

local function unobstructed(player, position)
 local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not root then return false end
 local parameters = RaycastParams.new()
 parameters.FilterType = Enum.RaycastFilterType.Exclude
 parameters.FilterDescendantsInstances = {player.Character, foodFolder, npcFolder}
 local hit = workspace:Raycast(root.Position, position - root.Position, parameters)
 return not hit or not hit.Instance.CanCollide
end

local function consumeFood(player, model)
 local root = playerRoot(player)
 local entry = Ecology.ActiveFoods[model]
 if not root or not entry or not Ecology.InEatingRange(root.Position, entry.Position)
  or not unobstructed(player, entry.Position) then return false end
 entry = Ecology.Claim(Ecology.ActiveFoods, model)
 if not entry then return false end
 model:Destroy()
 respawnFood(entry)
 callbacks.OnEat(player, entry.Spec, {Kind="Food", MutationFood=isMutation(entry.Spec), Boost=entry.Boost})
 return true
end

local function touchingPlayer(hit)
 local character = hit and hit:FindFirstAncestorOfClass("Model")
 if not character then return nil end
 local player = Players:GetPlayerFromCharacter(character)
 if player then return player end
 -- AnimalVisual is itself a Model beneath the player's Character.
 return character.Parent and character.Parent:IsA("Model") and Players:GetPlayerFromCharacter(character.Parent) or nil
end

local function prompt(root, label, action)
 local interaction = Instance.new("ProximityPrompt")
 interaction.Name = "EatPrompt"
 interaction.ActionText = action or "Ăn"
 interaction.ObjectText = label
 interaction.KeyboardKeyCode = Enum.KeyCode.E
 interaction.GamepadKeyCode = Enum.KeyCode.ButtonX
 interaction.MaxActivationDistance = EAT_RANGE
 interaction.RequiresLineOfSight = true
 interaction.HoldDuration = 0
 interaction.Parent = root
 return interaction
end

spawnFood = function(position, biome, spec, boosted)
 local model = FoodModels.Create(spec, foodFolder, boosted)
 model:PivotTo(CFrame.new(position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
 model:SetAttribute("Biome", biome)
 local entry = {Model=model, Spec=spec, Position=model.PrimaryPart.Position, GroundPosition=position,
  Biome=biome, Boost=boosted and 3 or 1, Claimed=false}
 Ecology.ActiveFoods[model] = entry
 prompt(model.PrimaryPart, spec.Name or "Thức ăn")
 -- Prompt events, like touch events, go through the same authoritative claim.
 model.PrimaryPart.EatPrompt.Triggered:Connect(function(player) consumeFood(player, model) end)
 model.PrimaryPart.Touched:Connect(function(hit)
  local player = touchingPlayer(hit)
  if player then consumeFood(player, model) end
 end)
 return model
end

function Ecology.SpawnMutationFood(position, boosted)
 if not world or not foodFolder then return nil end
 local ground = world.GroundPosition(position)
 if not ground then return nil end
 return spawnFood(ground, world.BiomeAt(ground), mutationSpec(), boosted == true)
end

local spawnNPC
local function npcVisual(entry)
 local previous = entry.Model:FindFirstChild("AnimalVisual")
 if previous then previous:Destroy() end
 local visual = AnimalModels.Create(entry.Form, entry.Model)
 visual.Name = "AnimalVisual"
 visual:ScaleTo(.9 + entry.Form * .055)
 visual:PivotTo(entry.Root.CFrame)
 if AnimalModels.Rig then AnimalModels.Rig(visual, entry.Root) end
 entry.Model:SetAttribute("Form", entry.Form)
 entry.Model:SetAttribute("NPCSpecies", entry.Form)
 entry.Model:SetAttribute("VisualScale", .9 + entry.Form * .055)
 local definition = AnimalModels.Definitions[entry.Form]
 local collider = definition and definition.Collider or {2, 2, 3}
 entry.Size = collider[1] * collider[2] * collider[3] * (.9 + entry.Form * .055) ^ 3
 local spec = Config.Species[entry.Form]
 entry.Caption.Text = string.format("%s · Bậc %d", spec and spec.Name or "Sinh vật", entry.Form)
 entry.Prompt.ObjectText = string.format("%s · ăn được khi nhỏ hơn bạn", spec and spec.Name or "Sinh vật")
end

local function canHunt(player, entry)
 return Ecology.CanEatNPC(callbacks.GetPlayerForm(player), entry.Form,
  callbacks.GetPlayerSize and callbacks.GetPlayerSize(player), entry.Size)
end

local function consumeNPC(player, model)
 local root = playerRoot(player)
 local entry = Ecology.ActiveNPCs[model]
 if not root or not entry or not Ecology.InEatingRange(root.Position, entry.Root.Position)
  or not canHunt(player, entry) or not unobstructed(player, entry.Root.Position) then return false end
 entry = Ecology.Claim(Ecology.ActiveNPCs, model)
 if not entry then return false end
 local form, biome = entry.Form, entry.Biome
 if entry.MoveTween then entry.MoveTween:Cancel() end
 model:Destroy()
 local currentGeneration = generation
 task.delay(rng:NextNumber(45, 80), function()
  if generation ~= currentGeneration then return end
  local position = world.RandomPosition(biome, rng)
  if position then spawnNPC(position, biome, rng:NextInteger(1, 8)) end
 end)
 callbacks.OnEat(player, {Id="prey", Name=Config.Species[form].Name, Hunger=math.min(10, 2 + form), Coins=4 * form},
  {Kind="NPC", MutationFood=false, Boost=1, Form=form})
 return true
end

spawnNPC = function(position, biome, form)
 npcSerial += 1
 local model = Instance.new("Model")
 model.Name = "Wildlife" .. npcSerial
 model:SetAttribute("IsNPC", true)
 model:SetAttribute("Biome", biome)
 local root = Instance.new("Part")
 root.Name = "HumanoidRootPart"
 root.Size = Vector3.new(4, 4, 4)
 root.CFrame = CFrame.new(position)
 root.Transparency = 1
 root.Anchored = true
 root.CanCollide = false
 root.CanTouch = true
 root.CanQuery = false
 root.Parent = model
 model.PrimaryPart = root
 local board = Instance.new("BillboardGui")
 board.Name = "WildlifeCaption"
 board.Size = UDim2.fromOffset(160, 30)
 board.StudsOffset = Vector3.new(0, 5.5, 0)
 board.MaxDistance = 65
 board.Parent = root
 local label = Instance.new("TextLabel")
 label.BackgroundTransparency = 1
 label.Size = UDim2.fromScale(1, 1)
 label.Font = Enum.Font.GothamMedium
 label.TextSize = 12
 label.TextColor3 = Color3.fromRGB(255, 230, 177)
 label.TextStrokeTransparency = .25
 label.Parent = board
 model.Parent = npcFolder
 local eatPrompt = prompt(root, "Sinh vật nhỏ", "Săn / Ăn")
 local entry = {Model=model, Root=root, Form=form, Biome=biome, Hunger=0, Claimed=false,
  Target=nil, SearchAt=0, WanderAt=0, Goal=position, Caption=label, Prompt=eatPrompt,
  Raycast=RaycastParams.new()}
 entry.Raycast.FilterType = Enum.RaycastFilterType.Exclude
 entry.Raycast.FilterDescendantsInstances = {model, foodFolder, npcFolder}
 Ecology.ActiveNPCs[model] = entry
 npcVisual(entry)
 eatPrompt.Triggered:Connect(function(player) consumeNPC(player, model) end)
 root.Touched:Connect(function(hit)
  local player = touchingPlayer(hit)
  if player then consumeNPC(player, model) end
 end)
 return model
end

local function closestFood(entry)
 local nearest, distance = nil, 320
 for model, food in pairs(Ecology.ActiveFoods) do
  if food.Biome == entry.Biome then
   local separation = horizontalDistance(entry.Root.Position, food.Position)
   if separation &lt; distance then distance, nearest = separation, model end
  end
 end
 return nearest
end

local function threatPosition(entry)
 for _, player in ipairs(Players:GetPlayers()) do
  local root = playerRoot(player)
  if root and canHunt(player, entry)
   and horizontalDistance(root.Position, entry.Root.Position) &lt; 26 then return root.Position end
 end
 return nil
end

local function stepNPC(entry, delta, now)
 if not entry.Model.Parent then Ecology.ActiveNPCs[entry.Model] = nil; return end
 local position = entry.Root.Position
 if now &gt;= entry.SearchAt then
  entry.SearchAt = now + .9 + rng:NextNumber(0, .3)
  entry.Target = closestFood(entry)
  local threat = threatPosition(entry)
  if threat then
   local away = Vector3.new(position.X - threat.X, 0, position.Z - threat.Z)
   if away.Magnitude &gt; .1 then
    local safe = world.GroundPosition(position + away.Unit * 45)
    if safe and world.BiomeAt(safe) == entry.Biome then
     entry.Goal, entry.Target, entry.WanderAt = safe, nil, now + 3
     entry.Model:SetAttribute("Activity", "Né thú lớn")
    end
   end
  end
 end
 local food = entry.Target and Ecology.ActiveFoods[entry.Target]
 if food then
  entry.Goal = food.GroundPosition
  entry.Model:SetAttribute("Activity", "Tranh thức ăn")
  if horizontalDistance(position, food.Position) &lt; 3.5 and math.abs(position.Y - food.GroundPosition.Y) &lt; 4 then
   local eaten = Ecology.Claim(Ecology.ActiveFoods, entry.Target)
   if eaten then
    eaten.Model:Destroy()
    respawnFood(eaten)
    entry.Hunger += eaten.Spec.Hunger or .5
    if entry.Hunger &gt;= 100 and entry.Form &lt; 8 then
     entry.Hunger -= 100
     entry.Form += 1
     npcVisual(entry)
    end
   end
   entry.Target = nil
  end
 elseif now &gt;= entry.WanderAt or horizontalDistance(position, entry.Goal) &lt; 5 then
  entry.Goal = world.RandomPosition(entry.Biome, rng) or position
  entry.WanderAt = now + rng:NextNumber(12, 24)
  entry.Model:SetAttribute("Activity", "Tìm thức ăn")
 end
 local offset = Vector3.new(entry.Goal.X - position.X, 0, entry.Goal.Z - position.Z)
 if offset.Magnitude &lt; .3 then entry.Model:SetAttribute("Moving", false); return end
 local direction = offset.Unit
 local distance = math.min(offset.Magnitude, (9 + entry.Form * 1.4) * delta)
 local eye = position + Vector3.new(0, 2, 0)
 local obstacle = workspace:Raycast(eye, direction * (distance + 3), entry.Raycast)
 if obstacle and obstacle.Instance.CanCollide then
  direction = Vector3.new(-direction.Z, 0, direction.X)
 end
 local ground = world.GroundPosition(position + direction * distance)
 -- Never snap across water, lava, steep cliffs, or a different habitat.
 if not ground or world.BiomeAt(ground) ~= entry.Biome or math.abs(ground.Y - position.Y) &gt; 3 then
  entry.Target = nil
  entry.WanderAt = 0
  entry.Model:SetAttribute("Moving", false)
  return
 end
 entry.Model:SetAttribute("Moving", true)
 entry.Model:SetAttribute("NPCWalkSpeed", 9 + entry.Form * 1.4)
 entry.Model:SetAttribute("MoveSpeed", 9 + entry.Form * 1.4)
 local destination = CFrame.lookAt(ground, ground + direction)
 if AnimalModels.Rig and TweenService then
  -- Only the anchored root moves; Motor6Ds carry the detailed anatomy with it.
  -- Smooth motion needs no per-frame model PivotTo or untrusted client positions.
  if entry.MoveTween then entry.MoveTween:Cancel() end
  entry.MoveTween = TweenService:Create(entry.Root, TweenInfo.new(delta, Enum.EasingStyle.Linear), {CFrame=destination})
  entry.MoveTween:Play()
 else
  entry.Model:PivotTo(destination)
 end
end

function Ecology.TryEat(player, target)
 local root = playerRoot(player)
 if not root then return false end
 if typeof(target) == "Instance" then
  local model = target
  while model and model ~= workspace do
   if Ecology.ActiveFoods[model] then return consumeFood(player, model) end
   if Ecology.ActiveNPCs[model] then return consumeNPC(player, model) end
   model = model.Parent
  end
  return false
 end
 local selected, best, kind = nil, EAT_RANGE + .01, nil
 for model, entry in pairs(Ecology.ActiveFoods) do
  local distance = horizontalDistance(root.Position, entry.Position)
  if distance &lt; best and Ecology.InEatingRange(root.Position, entry.Position) then selected, best, kind = model, distance, "Food" end
 end
 for model, entry in pairs(Ecology.ActiveNPCs) do
  local distance = horizontalDistance(root.Position, entry.Root.Position)
  if distance &lt; best and Ecology.InEatingRange(root.Position, entry.Root.Position) and canHunt(player, entry) then
   selected, best, kind = model, distance, "NPC"
  end
 end
 if not selected then return false end
 if kind == "Food" then return consumeFood(player, selected) end
 return consumeNPC(player, selected)
end

Ecology.AttackNearest = Ecology.TryEat

function Ecology.Stop()
 generation += 1
 if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
 for _, entry in pairs(Ecology.ActiveNPCs) do if entry.MoveTween then entry.MoveTween:Cancel() end end
 if foodFolder then foodFolder:Destroy() end
 if npcFolder then npcFolder:Destroy() end
 Ecology.ActiveFoods, Ecology.ActiveNPCs = {}, {}
 foodFolder, npcFolder = nil, nil
end

function Ecology.Start(worldModule, handlers)
 Ecology.Stop()
 world, callbacks = worldModule, handlers
 assert(type(callbacks.OnEat) == "function" and type(callbacks.GetPlayerForm) == "function", "Ecology requires food and form callbacks")
 -- Layout can be seeded, while edible spawns stay unpredictable across servers.
 rng = Config.EcologySeed and Random.new(Config.EcologySeed) or Random.new()
 elapsed = 0
 foodFolder = Instance.new("Folder")
 foodFolder.Name = "Foods"
 foodFolder.Parent = workspace
 npcFolder = Instance.new("Folder")
 npcFolder.Name = "Wildlife"
 npcFolder.Parent = workspace
 local candidates = table.clone(world.FoodSpawnPoints or {})
 for i = #candidates, 2, -1 do
  local j = rng:NextInteger(1, i)
  candidates[i], candidates[j] = candidates[j], candidates[i]
 end
 local count = 0
 for _, candidate in ipairs(candidates) do
  if count &gt;= (Config.FoodCount or 220) then break end
  if not reserved(candidate.Position) then
   spawnFood(candidate.Position, candidate.Biome, Ecology.RollFood(rng, candidate.Biome))
   count += 1
  end
 end
 local biomes = world.Biomes or Config.Biomes
 for i = 1, (Config.NPCCount or 24) do
  local biome = biomes[1 + (i - 1) % #biomes].Id
  local position = world.RandomPosition(biome, rng)
  if position then spawnNPC(position, biome, 1 + (i - 1) % 8) end
 end
 heartbeat = RunService.Heartbeat:Connect(function(delta)
  elapsed += delta
  if elapsed &lt; .25 then return end
  local step = math.min(elapsed, .5)
  elapsed = 0
  local now = os.clock()
  for _, entry in pairs(Ecology.ActiveNPCs) do stepNPC(entry, step, now) end
 end)
 return Ecology
end

return Ecology
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5474">
        <Properties>
          <string name="Name">Events</string>
          <ProtectedString name="Source">-- Server-authoritative, contested supply drops. Paid purchases grant durable
-- credits in Main; this module only queues a physical, publicly contestable drop.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.EventRules)
local Events = {}
local world, callbacks, folder
local active, purchased, pending = {}, {}, 0
local rng = Random.new()
local started = false

local function setting(name, default)
 local values = Config.Drop or Config.SupplyDrop or {}
 return values[name] or default
end
local function announce(entry, status)
 entry.Status = status
 if callbacks.Broadcast then
  callbacks.Broadcast("Drop", {Id=entry.Id, Position=entry.Position, LandingAt=entry.LandingAt, Status=status})
 end
end
local function part(parent, name, size, position, color, material, shape)
 local result = Instance.new("Part")
 result.Name = name
 result.Anchored = true
 result.CanCollide = false
 result.CanTouch = false
 result.CanQuery = false
 result.Size = size
 result.CFrame = CFrame.new(position)
 result.Color = color
 result.Material = material or Enum.Material.SmoothPlastic
 result.TopSurface = Enum.SurfaceType.Smooth
 result.BottomSurface = Enum.SurfaceType.Smooth
 if shape then result.Shape = shape end
 result.Parent = parent
 return result
end
local function link(parent, name, a, b, width, color)
 local length = (b-a).Magnitude
 local result = part(parent, name, Vector3.new(width, width, length), (a+b)/2, color)
 result.CFrame = CFrame.lookAt((a+b)/2, b)
 return result
end
local function label(parent, title, subtitle)
 local gui = Instance.new("BillboardGui")
 gui.Name = "SupplyLabel"
 gui.Size = UDim2.fromOffset(280, 68)
 gui.StudsOffset = Vector3.new(0, 9, 0)
 gui.AlwaysOnTop = false
 gui.MaxDistance = 700
 gui.Parent = parent
 local text = Instance.new("TextLabel")
 text.Size = UDim2.fromScale(1, 1)
 text.BackgroundTransparency = .24
 text.BackgroundColor3 = Color3.fromRGB(18, 27, 39)
 text.TextColor3 = Color3.fromRGB(255, 220, 124)
 text.TextSize = 19
 text.Font = Enum.Font.GothamBold
 text.TextWrapped = true
 text.Text = title .. "\n" .. subtitle
 text.Parent = gui
 local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = text
 return text
end
local function beacon(entry)
 local model = Instance.new("Model")
 model.Name = "LandingBeacon_" .. entry.Id
 model.Parent = folder
 local anchor = part(model, "Target", Vector3.new(3,.15,3), entry.Position+Vector3.new(0,.25,0), Color3.fromRGB(255, 197, 76), Enum.Material.Neon)
 for i = 1, 24 do
  local angle = i/24*math.pi*2
  local radius = 22
  local marker = part(model, "TargetRing", Vector3.new(5.9,.18,1.25), entry.Position+Vector3.new(math.cos(angle)*radius,.35,math.sin(angle)*radius), anchor.Color, Enum.Material.Neon)
  marker.CFrame = CFrame.new(marker.Position)*CFrame.Angles(0,-angle-math.pi/2,0)
 end
 local beam = part(model, "SkyBeacon", Vector3.new(320,1.9,1.9), entry.Position+Vector3.new(0,160,0), anchor.Color, Enum.Material.Neon, Enum.PartType.Cylinder)
 beam.CFrame = CFrame.new(beam.Position)*CFrame.Angles(0,0,math.pi/2)
 beam.Transparency = .65
 local light = Instance.new("PointLight"); light.Brightness=2; light.Range=45; light.Color=anchor.Color; light.Parent=anchor
 entry.Label = label(anchor, "THÍNH ĐANG ĐẾN", "Vị trí đã đánh dấu • Cạnh tranh để nhận quà")
 entry.Beacon = model
end
local function crate(entry)
 local model = Instance.new("Model")
 model.Name = "SupplyCrate_" .. entry.Id
 model:SetAttribute("DropId", entry.Id)
 model.Parent = folder
 local color = Color3.fromRGB(42, 76, 93)
 local trim = Color3.fromRGB(255, 195, 72)
 local body = part(model, "Cargo", Vector3.new(8,6,8), Vector3.zero, color, Enum.Material.Metal)
 model.PrimaryPart = body
 for _, x in ipairs({-4.1,4.1}) do
  part(model, "CargoEdge", Vector3.new(.35,6.5,8.5), Vector3.new(x,0,0), trim, Enum.Material.Metal)
 end
 for _, z in ipairs({-4.1,4.1}) do
  part(model, "CargoEdge", Vector3.new(8.5,6.5,.35), Vector3.new(0,0,z), trim, Enum.Material.Metal)
 end
 for _, x in ipairs({-2.4,2.4}) do
  part(model, "CargoStrap", Vector3.new(.42,6.25,8.25), Vector3.new(x,0,0), Color3.fromRGB(17,28,35), Enum.Material.Metal)
 end
 part(model, "CargoLid", Vector3.new(8.5,.55,8.5), Vector3.new(0,3.1,0), trim, Enum.Material.Metal)
 for _, z in ipairs({-4.3,4.3}) do
  part(model, "CargoSignal", Vector3.new(4.7,.7,.22), Vector3.new(0,.8,z), Color3.fromRGB(135,255,191), Enum.Material.Neon)
 end
 local canopy = Instance.new("Model")
 canopy.Name = "Parachute"; canopy.Parent=model
 local canopyTop = part(canopy, "Canopy", Vector3.new(28,8,28), Vector3.new(0,30,0), Color3.fromRGB(232,81,65), Enum.Material.Fabric, Enum.PartType.Ball)
 canopyTop.Transparency = .08
 for i = 1, 12 do
  local angle = (i-1)/12*math.pi*2
  local point = Vector3.new(math.cos(angle)*11.8,27,math.sin(angle)*11.8)
  local panel = part(canopy, "CanopyPanel", Vector3.new(7.1,.5,11.5), Vector3.new(math.cos(angle)*7,30.5,math.sin(angle)*7), i%2==0 and Color3.fromRGB(249,231,192) or Color3.fromRGB(227,93,58), Enum.Material.Fabric)
  panel.CFrame = CFrame.new(panel.Position)*CFrame.Angles(0,-angle,math.rad(18))
  link(canopy, "SuspensionRope", point, Vector3.new(math.cos(angle)*3.4,3.2,math.sin(angle)*3.4), .12, Color3.fromRGB(238,236,213))
 end
 local light = Instance.new("PointLight"); light.Color=trim; light.Brightness=3; light.Range=35; light.Parent=body
 entry.Crate = model
 entry.Canopy = canopy
 model:PivotTo(CFrame.new(entry.Position+Vector3.new(0,700,0)))
 return body
end
local function cleanup(entry)
 if not active[entry.Id] then return end
 active[entry.Id] = nil
 pending = math.max(0, pending-1)
 if entry.Prompt then entry.Prompt.Enabled = false end
 if entry.Crate then entry.Crate:Destroy() end
 if entry.Beacon then entry.Beacon:Destroy() end
end
local function validPlayer(player, entry)
 if not player or player.Parent ~= Players then return false end
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 return root and humanoid and humanoid.Health &gt; 0 and (root.Position-(entry.Position+Vector3.new(0,4,0))).Magnitude &lt;= 16
end
local function claim(player, entry)
 if active[entry.Id] ~= entry or entry.Status ~= "Landed" or not validPlayer(player, entry) then return end
 -- Lock before calling the economy callback; multiple simultaneous prompts
 -- can never award the same crate. A rejected claim can be retried.
 entry.Status = "Claiming"
 entry.Prompt.Enabled = false
 local payload = {
  Coins=rng:NextInteger(setting("CoinsMin",800),setting("CoinsMax",1800)),
  Fullness=rng:NextInteger(setting("FullnessMin",20),setting("FullnessMax",50)),
  MutationBoost=3, DropId=entry.Id,
 }
 local ok, accepted = pcall(callbacks.OnClaim, player, payload)
 if ok and accepted == false then
  entry.Status = "Landed"; entry.Prompt.Enabled = true
  return
 end
 if not ok then warn("Supply drop claim callback failed; suppressing duplicate award", entry.Id) end
 announce(entry, "Claimed")
 cleanup(entry)
end
local function landing(entry)
 if active[entry.Id] ~= entry then return end
 if not entry.Crate then crate(entry) end
 entry.Crate:PivotTo(CFrame.new(entry.Position+Vector3.new(0,3.5,0)))
 if entry.Canopy then entry.Canopy:Destroy(); entry.Canopy=nil end
 if entry.Label then entry.Label.Text = "THÍNH ĐÃ HẠ CÁNH\nCoins + 20–50% độ no + món đột biến ×3" end
 local prompt = Instance.new("ProximityPrompt")
 prompt.ActionText="Mở thính"; prompt.ObjectText="Coins • Thức ăn • Đột biến"
 prompt.MaxActivationDistance=12; prompt.RequiresLineOfSight=true; prompt.HoldDuration=1.25
 prompt.Parent=entry.Crate.PrimaryPart; entry.Prompt=prompt
 prompt.Triggered:Connect(function(player) claim(player, entry) end)
 announce(entry,"Landed")
 if entry.PurchaseId and callbacks.OnPurchasedDropDelivered then
  -- Physical delivery and a DataStore write cannot be one atomic operation.
  -- Main retains the paid credit until its acknowledgement is durably saved.
  -- Retry a transient failure even if another player already won the crate.
  task.spawn(function()
   for attempt = 1, 12 do
    local ok, acknowledged = pcall(callbacks.OnPurchasedDropDelivered, entry.Sponsor, entry.PurchaseId)
    if ok and acknowledged == true then return end
    if not ok then warn("Supply drop delivery acknowledgement failed", entry.PurchaseId) end
    task.wait(15)
   end
  end)
 end
 task.delay(setting("DespawnSeconds",600),function()
  if active[entry.Id] ~= entry or entry.Status ~= "Landed" then return end
  announce(entry,"Expired"); cleanup(entry)
 end)
end
local function descend(entry)
 if active[entry.Id] ~= entry then return end
 crate(entry)
 local began=workspace:GetServerTimeNow()
 local duration=math.max(.01,entry.LandingAt-began)
 while active[entry.Id] == entry and workspace:GetServerTimeNow() &lt; entry.LandingAt do
  local progress=math.clamp((workspace:GetServerTimeNow()-began)/duration,0,1)
  local height=3.5+(1-progress)*696.5
  local sway=math.sin(progress*math.pi*4)*(1-progress)*12
  entry.Crate:PivotTo(CFrame.new(entry.Position+Vector3.new(sway,height,0))*CFrame.Angles(0,progress*.4,0))
  RunService.Heartbeat:Wait()
 end
 landing(entry)
end
local function safePosition()
 local position
 if world.GetDropPosition then position=world.GetDropPosition(rng)
 elseif world.RandomPosition then position=world.RandomPosition(rng) end
 if typeof(position) ~= "Vector3" then return nil end
 if world.IsSafePosition and not world.IsSafePosition(position) then return nil end
 return position
end
local function queue(player, purchaseId)
 if not started or pending &gt;= setting("MaxPending",3) or not callbacks.OnClaim then return false end
 if purchaseId and purchased[purchaseId] then return true end
 local position=safePosition()
 if not position then return false end
 local warning=setting("WarningSeconds",180)
 local entry={Id=HttpService:GenerateGUID(false),Position=position,LandingAt=workspace:GetServerTimeNow()+warning,Status="Incoming",Sponsor=player,PurchaseId=purchaseId}
 active[entry.Id]=entry; pending+=1
 if purchaseId then purchased[purchaseId]=entry.Id end
 beacon(entry)
 announce(entry,"Incoming")
 if player and callbacks.Message then callbacks.Message(player,"Thính của bạn đã được đánh dấu. Hạ cánh sau 3 phút; mọi người đều có thể tranh giành!") end
 task.delay(math.max(0,warning-20),function() descend(entry) end)
 return true
end

function Events.RequestPurchasedDrop(player, purchaseId)
 if not player or player.Parent ~= Players then return false end
 if purchaseId ~= nil and (typeof(purchaseId) ~= "string" or purchaseId == "") then return false end
 -- Idempotence is scoped to this server. Main persists paid credits and consumes
 -- one only after queue accepts; never use a client-supplied purchase ID here.
 if purchaseId and purchased[purchaseId] then return true end
 return queue(player,purchaseId)
end
function Events.GetActiveDrops()
 local result={}
 for _,entry in pairs(active) do
  if entry.Status ~= "Claiming" then table.insert(result,{Id=entry.Id,Position=entry.Position,LandingAt=entry.LandingAt,Status=entry.Status}) end
 end
 return result
end
function Events.Start(World, options)
 if started then return end
 world=World; callbacks=options or {}; started=true
 folder=workspace:FindFirstChild("SupplyDrops") or Instance.new("Folder")
 folder.Name="SupplyDrops"; folder.Parent=workspace
 task.spawn(function()
  while started do
   task.wait(setting("CheckInterval",300))
   local count=#Players:GetPlayers()
   if count &gt; 0 and Rules.RollDrop(count,rng) then queue(nil,nil) end
  end
 end)
end
return Events
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX5475">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">-- Evolution Wilds: services are independent of persistence so Studio can play
-- an unpublished world. Every economy, combat and purchase decision is server-side.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Rules = require(ReplicatedStorage.Shared:WaitForChild("Rules"))
local Character = require(script.Parent:WaitForChild("Character"))
local World = require(script.Parent:WaitForChild("World"))
local Ecology = require(script.Parent:WaitForChild("Ecology"))
local Events = require(script.Parent:WaitForChild("Events"))
local Commerce = require(script.Parent:WaitForChild("Commerce"))

Players.CharacterAutoLoads = false
workspace:SetAttribute("EvolutionStatus", "Starting")
local profiles, locks, recentContacts, lastAction, lastAttack = {}, {}, {}, {}, {}
local serverToken = HttpService:GenerateGUID(false)
local rng = Random.new()
local remote = ReplicatedStorage:FindFirstChild("EvolutionEvent") or Instance.new("RemoteEvent")
remote.Name = "EvolutionEvent"
remote.Parent = ReplicatedStorage
local store
local flushCredits

local function alive(player)
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health &lt;= 0 then return nil end
 return root, humanoid
end
local function volume(player)
 local collider = player.Character and player.Character:FindFirstChild("AnimalCollider")
 return collider and collider.Size.X*collider.Size.Y*collider.Size.Z or 0
end
local function positionRecord(position, biome)
 return {X=position.X,Y=position.Y,Z=position.Z,Biome=biome}
end
local function storedVector(value)
 if typeof(value)~="table" then return nil end
 for _, axis in ipairs({"X","Y","Z"}) do
  if typeof(value[axis])~="number" or value[axis]~=value[axis] or math.abs(value[axis])&gt;100000 then return nil end
 end
 return Vector3.new(value.X,value.Y,value.Z)
end
local function metadata(raw)
 local credits, receipts, dispatches = {}, {}, {}
 if typeof(raw)=="table" then
  for key, value in pairs(typeof(raw.DropCredits)=="table" and raw.DropCredits or {}) do
   if typeof(key)=="string" and #key&gt;0 and #key&lt;=200 and value==true then credits[key]=true end
  end
  for key, value in pairs(typeof(raw.ReceiptIds)=="table" and raw.ReceiptIds or {}) do
   if typeof(key)=="string" and #key&gt;0 and #key&lt;=200 and typeof(value)=="number" then receipts[key]=value end
  end
  for key,value in pairs(typeof(raw.DropDispatches)=="table" and raw.DropDispatches or {}) do
   if typeof(key)=="string" and #key&lt;=200 and typeof(value)=="table" and typeof(value.Server)=="string"
    and typeof(value.Lease)=="number" and value.Lease==value.Lease then
    dispatches[key]={Server=value.Server,Lease=value.Lease}
   end
  end
 end
 return credits, receipts, dispatches
end
local function sync(player, message)
 local data=profiles[player]
 if not data or not player.Parent then return end
 local root=alive(player)
 local biome=(root and World.PositionBiome(root.Position)) or data.Biome or "meadow"
 data.Biome=biome
 local stats=player:FindFirstChild("leaderstats")
 if stats then
  stats.Coins.Value=data.Coins
  stats.Evolution.Value=data.Unlocked
 end
 local now=os.time()
 local offer=data.LastDeath and math.max(0,Config.NearRespawnOfferSeconds-(now-data.LastDeath.At)) or 0
 local cooldown=math.max(0,(data.NearReviveReadyAt or 0)-now)
 local availability=Commerce.GetAvailability(player)
 availability.DropAvailable=availability.DropAvailable and store~=nil and not data.ReadOnly and not data.Loading
 remote:FireClient(player,"State",{
  Coins=data.Coins,Fullness=data.Fullness,Form=data.Form,Unlocked=data.Unlocked,
  Mutations=table.clone(data.Mutations),FreeRerolls=data.FreeRerolls,LastMutationBoost=data.LastMutationBoost,
  PassOwned=Commerce.HasPass(player),ReadOnly=data.ReadOnly,Loading=data.Loading,
  Biome=biome,ReviveAvailable=Commerce.HasPass(player) and offer&gt;0 and cooldown==0,
  ReviveCooldown=cooldown,ReviveExpiresIn=offer,Commerce=availability,CommerceConfig=Config.Commerce,Message=message,
 })
end
local function grantProtection(player, seconds)
 local data=profiles[player]
 if not data then return end
 data.ProtectedUntil=os.clock()+seconds
 if player.Character then player.Character:SetAttribute("SpawnProtectedUntil",workspace:GetServerTimeNow()+seconds) end
end
local function teleportCharacter(player, destination)
 local root=alive(player)
 if not root or not destination then return false end
 player.Character:PivotTo(destination)
 root.AssemblyLinearVelocity=Vector3.zero
 root.AssemblyAngularVelocity=Vector3.zero
 return true
end
local function copyProgress(data, old, release)
 local payload=Rules.Normalize(data)
 payload.DropCredits,payload.ReceiptIds,payload.DropDispatches=metadata(old)
 payload.NearReviveReadyAt=data.NearReviveReadyAt or 0
 payload.Position=data.LastPosition
 payload.Lease=release and 0 or os.time()+180
 if not release then payload.Session=data.SessionToken end
 return payload
end
local function acquireLock(userId)
 while locks[userId] do task.wait(0.05) end
 locks[userId]=true
end
local function save(player, release)
 local data=profiles[player]
 if not store or not data or data.ReadOnly or data.Loading then return false end
 acquireLock(player.UserId)
 if profiles[player]~=data or data.ReadOnly or data.Loading then locks[player.UserId]=nil; return false end
 local root=alive(player)
 if root and World.IsSafe(root.Position) then
  data.LastPosition=positionRecord(root.Position,World.PositionBiome(root.Position))
 end
 local ok,result=pcall(function()
  return store:UpdateAsync("player_"..player.UserId,function(old)
   if typeof(old)~="table" or old.Session~=data.SessionToken then return nil end
   return copyProgress(data,old,release)
  end)
 end)
 locks[player.UserId]=nil
 if not ok then
  warn("Evolution save unavailable",player.UserId,result)
  sync(player,"Chưa lưu được tiến trình; máy chủ sẽ thử lại.")
  return false
 end
 if not result then
  data.ReadOnly=true
  sync(player,"Mất khóa dữ liệu: phiên này không ghi đè tiến trình đã lưu.")
  return false
 end
 data.DropCredits,data.ReceiptIds,data.DropDispatches=metadata(result)
 return true
end
local function grantDropCredit(player,purchaseId)
 local data=profiles[player]
 if not store or not data or data.Loading or data.ReadOnly then return false end
 acquireLock(player.UserId)
 local accepted=false
 local ok,result=pcall(function()
  return store:UpdateAsync("player_"..player.UserId,function(old)
   if typeof(old)~="table" or old.Session~=data.SessionToken then accepted=false; return nil end
   local nextData=copyProgress(data,old,false)
   if not nextData.ReceiptIds[purchaseId] then
    nextData.ReceiptIds[purchaseId]=os.time()
    nextData.DropCredits[purchaseId]=true
   end
   accepted=true
   return nextData
  end)
 end)
 locks[player.UserId]=nil
 if ok and accepted and result then
  data.DropCredits,data.ReceiptIds,data.DropDispatches=metadata(result)
  return true
 end
 return false
end
local function acknowledgeDrop(sponsor,purchaseId)
 -- Touch only this purchase's credit, even if the sponsor left or rejoined.
 -- Progress/session fields belonging to another server remain untouched.
 if not store or not sponsor then return false end
 local userId=sponsor.UserId
 acquireLock(userId)
 local acknowledged=false
 local ok,result=pcall(function()
  return store:UpdateAsync("player_"..userId,function(old)
   if typeof(old)~="table" then return nil end
   local credits,receipts,dispatches=metadata(old)
   if not receipts[purchaseId] then return nil end
   credits[purchaseId]=nil
   dispatches[purchaseId]=nil
   old.DropCredits=credits
   old.DropDispatches=dispatches
   acknowledged=true
   return old
  end)
 end)
 locks[userId]=nil
 if ok and acknowledged and result then
  local current=Players:GetPlayerByUserId(userId)
  if current and profiles[current] then
   profiles[current].DropCredits[purchaseId]=nil
   profiles[current].DropDispatches[purchaseId]=nil
  end
  return true
 end
 return false
end
local function reserveDispatch(player,purchaseId,release)
 local data=profiles[player]
 if not store or not data or data.ReadOnly or data.Loading then return false end
 acquireLock(player.UserId)
 local reserved=false
 local ok,result=pcall(function()
  return store:UpdateAsync("player_"..player.UserId,function(old)
   reserved=false
   if typeof(old)~="table" or old.Session~=data.SessionToken then return nil end
   local credits,receipts,dispatches=metadata(old)
   if not credits[purchaseId] or not receipts[purchaseId] then return nil end
   local dispatch=dispatches[purchaseId]
   if release then
    if dispatch and dispatch.Server==serverToken then dispatches[purchaseId]=nil end
   else
    -- A pending paid drop belongs to one server until it lands or this lease
    -- expires after a crash. Rejoining cannot announce it on every server.
    if dispatch and dispatch.Server~=serverToken and dispatch.Lease&gt;os.time() then return nil end
    dispatches[purchaseId]={Server=serverToken,Lease=os.time()+360}
    reserved=true
   end
   old.DropDispatches=dispatches
   return old
  end)
 end)
 locks[player.UserId]=nil
 if ok and result then data.DropCredits,data.ReceiptIds,data.DropDispatches=metadata(result) end
 return ok and reserved
end
flushCredits=function(player)
 local data=profiles[player]
 if not data or data.ReadOnly or data.Loading then return end
 for purchaseId in pairs(data.DropCredits) do
  if not data.QueuedCredits[purchaseId] and reserveDispatch(player,purchaseId,false) then
   if Events.RequestPurchasedDrop(player,purchaseId) then data.QueuedCredits[purchaseId]=true
   else reserveDispatch(player,purchaseId,true) end
  end
 end
end

local function canEat(player)
 local data=profiles[player]
 return data~=nil and not data.Loading and alive(player)~=nil
end
local function awardFood(player,spec,source)
 local data=profiles[player]
 if not data or not canEat(player) then return end
 local gain, coins=Rules.AddFood(data,spec,Commerce.HasPass(player))
 local mutated=source and source.MutationFood
 local message=string.format("%s: +%g%% no · +%d Coins",spec.Name or "Thức ăn",gain,coins)
 if mutated then
  local name=Rules.StartMutation(data,rng,source.Boost==3 and 3 or 1,Commerce.HasPass(player))
  Character.Apply(player,data)
  message="Thức ăn đột biến: "..Config.Mutation(name).Label..(data.FreeRerolls&gt;0 and " · 2 reroll miễn phí" or "")
  remote:FireClient(player,"Mutation",name)
 end
 local root=alive(player)
 remote:FireClient(player,"Food",{Gain=gain,Coins=coins,Position=root and root.Position,Name=spec.Name,MutationFood=mutated})
 if Rules.CanEvolve(data) then message..=" · Đủ no! Nhấn Tiến hóa." end
 sync(player,message)
end
local function buyTeleport(player,sourceId,destinationId)
 local data=profiles[player]
 local root=alive(player)
 local source=World.Teleports[sourceId]
 local destination=World.Teleports[destinationId]
 if not data or data.Loading or not root or not source or not destination or sourceId==destinationId then return false end
 local part=source.Part
 if not part or (root.Position-part.Position).Magnitude&gt;18 then return false end
 local cost=source.Cost or 150
 if data.Coins&lt;cost then sync(player,"Cần "..cost.." Coins để dịch chuyển."); return false end
 data.Coins-=cost
 sync(player,"Dịch chuyển đến "..(destination.Name or destinationId).." · -"..cost.." Coins")
 grantProtection(player,2)
 return true
end
Character.Initialize()
World.Build({
 OnBridge=function(player,part,cost)
  local data=profiles[player]; local root=alive(player)
  if not data or data.Loading or not root or (root.Position-part.Position).Magnitude&gt;part.Size.Magnitude/2+25 then return false end
  if data.Coins&lt;cost then sync(player,"Qua cầu cần "..cost.." Coins; bạn có thể nhảy qua đá miễn phí."); return false end
  data.Coins-=cost; sync(player,"Phí cầu: -"..cost.." Coins")
  return true
 end,
 OnTeleport=buyTeleport,
 OnTeleportMenu=function(player,sourceId,destinations)
  remote:FireClient(player,"TeleportMenu",{SourceId=sourceId,Destinations=destinations})
 end,
})
workspace:SetAttribute("EvolutionStatus","Ready")

-- Do not let persistence block open-world construction or the starter animal.
if not (RunService:IsStudio() and game.GameId==0) then
 local ok,result=pcall(function() return DataStoreService:GetDataStore("EvolutionObby_v1") end)
 if ok then store=result else warn("Evolution DataStore unavailable; temporary mode",result) end
end
workspace:SetAttribute("EvolutionPersistence",store and "Available" or "Temporary")
Commerce.Start({
 Message=sync,GrantDropCredit=grantDropCredit,OnDropCreditGranted=flushCredits,
 CanPurchaseDrop=function(player)
  local data=profiles[player]
  return store~=nil and data~=nil and not data.Loading and not data.ReadOnly
 end,
 OnPassChanged=function(player) sync(player) end,
 OnAvailabilityChanged=function() for player in pairs(profiles) do sync(player) end end,
})
Events.Start(World,{
 Broadcast=function(action,payload) remote:FireAllClients(action,payload) end,
 Message=sync,OnPurchasedDropDelivered=acknowledgeDrop,
 OnClaim=function(player,loot)
  if not canEat(player) then return false end
  awardFood(player,{Name="Thính",Hunger=loot.Fullness,Coins=loot.Coins},{MutationFood=true,Boost=3})
  return true
 end,
})
Ecology.Start(World,{
 OnEat=awardFood,CanEat=canEat,
 GetPlayerForm=function(player) local d=profiles[player]; return d and d.Form or 0 end,
 GetPlayerSize=volume,
})

local function attack(player)
 local data=profiles[player]
 local root=alive(player)
 if not data or data.Loading or not root then return end
 local now=os.clock()
 if now&lt;(data.ProtectedUntil or 0) then sync(player,"Bạn đang được bảo vệ sau khi hồi sinh."); return end
 if lastAttack[player] and now-lastAttack[player]&lt;Config.AttackCooldown then return end
 lastAttack[player]=now
 local target,bestDistance
 for _,other in ipairs(Players:GetPlayers()) do
  if other~=player then
   local otherData=profiles[other]
   local otherRoot,otherHumanoid=alive(other)
   local contact=recentContacts[player] and recentContacts[player][other]
   if otherData and not otherData.Loading and now&gt;=(otherData.ProtectedUntil or 0) and otherRoot then
    local distance=(otherRoot.Position-root.Position).Magnitude
    local ownCollider=player.Character:FindFirstChild("AnimalCollider")
    local otherCollider=other.Character:FindFirstChild("AnimalCollider")
    local reach=ownCollider and otherCollider and math.min(Config.AttackRange,(ownCollider.Size.Magnitude+otherCollider.Size.Magnitude)/2+0.6) or 4
    if distance&lt;=Config.AttackRange and ((contact and now-contact&lt;2) or distance&lt;=reach) then
     local ray=RaycastParams.new()
     ray.FilterType=Enum.RaycastFilterType.Exclude
     ray.FilterDescendantsInstances={player.Character,other.Character}
     local blocked=workspace:Raycast(root.Position,otherRoot.Position-root.Position,ray)
     if not blocked and (not bestDistance or distance&lt;bestDistance) then target={Player=other,Root=otherRoot,Humanoid=otherHumanoid};bestDistance=distance end
    end
   end
  end
 end
 if not target then sync(player,"Hãy chạm hoặc đứng sát người chơi khác để đẩy."); return end
 local direction=target.Root.Position-root.Position
 direction=Vector3.new(direction.X,0,direction.Z)
 if direction.Magnitude&lt;0.01 then direction=root.CFrame.LookVector else direction=direction.Unit end
 target.Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
 pcall(function() target.Root:SetNetworkOwner(nil) end)
 target.Root:ApplyImpulse((direction*Rules.AttackStrength(data.Form)+Vector3.new(0,12,0))*target.Root.AssemblyMass)
 task.delay(0.35,function()
  if target.Root.Parent then pcall(function() target.Root:SetNetworkOwner(target.Player) end) end
 end)
 remote:FireClient(player,"Attack",{Position=target.Root.Position,Strength=Rules.AttackStrength(data.Form)})
 remote:FireClient(target.Player,"Pushed",{By=player.DisplayName or player.Name})
end
local function reviveNear(player)
 local data=profiles[player]
 if not data or data.Loading or not Commerce.HasPass(player) then sync(player,"Cần gói hỗ trợ để hồi sinh gần nơi chết."); return end
 local death=data.LastDeath
 local now=os.time()
 if not death or now-death.At&gt;Config.NearRespawnOfferSeconds then sync(player,"Không còn điểm hồi sinh gần đang chờ."); return end
 if now&lt;(data.NearReviveReadyAt or 0) then sync(player,"Hồi sinh gần đang hồi chiêu 3 phút."); return end
 local ground=World.GroundPosition(death.Position)
 local destination=ground and CFrame.new(ground+Vector3.new(0,6,0)) or World.NearestSafeSpawn(death.Biome,death.Position)
 if not teleportCharacter(player,destination) then return end
 data.NearReviveReadyAt=now+Config.NearRespawnCooldown
 data.LastDeath=nil
 grantProtection(player,Config.SpawnProtectionSeconds)
 sync(player,"Đã hồi sinh gần nơi chết. Hồi chiêu: 3 phút.")
 task.spawn(save,player,false)
end
remote.OnServerEvent:Connect(function(player,action,value)
 local data=profiles[player]
 if not data or typeof(action)~="string" then return end
 local now=os.clock()
 if lastAction[player] and now-lastAction[player]&lt;0.16 then return end
 lastAction[player]=now
 if action=="Sync" then
  sync(player)
  for _,drop in ipairs(Events.GetActiveDrops()) do remote:FireClient(player,"Drop",drop) end
  return
 end
 if action=="BuyPass" then Commerce.PromptPass(player); return end
 if action=="BuyDrop" then Commerce.PromptSupplyDrop(player); return end
 if data.Loading then sync(player,"Đang tải tiến trình, vui lòng chờ một chút."); return end
 if not alive(player) then return end
 if action=="Evolve" then
  if Rules.Evolve(data) then
   Character.Apply(player,data)
   remote:FireClient(player,"Evolution",data.Form)
   sync(player,"Tiến hóa thành "..Config.Species[data.Form].Name.."!")
  else sync(player,data.Unlocked==#Config.Species and "Bạn đã mở loài cuối cùng." or "Cần ăn đủ 100% độ no để tiến hóa.") end
 elseif action=="Morph" then
  if typeof(value)~="number" or value~=value or value%1~=0 or value&lt;1 or value&gt;data.Unlocked then return end
  data.Form=value;Character.Apply(player,data);sync(player,"Đã đổi sang "..Config.Species[value].Name)
 elseif action=="Eat" then Ecology.TryEat(player)
 elseif action=="Attack" then attack(player)
 elseif action=="Reroll" then
  if not Commerce.HasPass(player) then sync(player,"Reroll miễn phí thuộc gói hỗ trợ."); return end
  local name=Rules.Reroll(data,rng)
  if name then Character.Apply(player,data);remote:FireClient(player,"Mutation",name);sync(player,"Đột biến: "..Config.Mutation(name).Label)
  else sync(player,"Ăn thức ăn đột biến để nhận 2 reroll miễn phí.") end
 elseif action=="Teleport" and typeof(value)=="string" then World.UseTeleport(player,value)
 elseif action=="ReviveNear" then reviveNear(player)
 end
end)

local function loadProfile(player)
 local data=profiles[player]
 if not data then return end
 if not store then data.Loading=false;sync(player,"Chơi thử không lưu. Ăn đủ no để tiến hóa!");return end
 acquireLock(player.UserId)
 local acquired
 local ok,err=pcall(function()
  acquired=store:UpdateAsync("player_"..player.UserId,function(old)
   if typeof(old)=="table" and old.Session and (tonumber(old.Lease) or 0)&gt;os.time() and old.Session~=data.SessionToken then return nil end
   local nextData=Rules.Normalize(old)
   nextData.DropCredits,nextData.ReceiptIds,nextData.DropDispatches=metadata(old)
   nextData.Position=typeof(old)=="table" and old.Position or nil
   nextData.NearReviveReadyAt=typeof(old)=="table" and tonumber(old.NearReviveReadyAt) or 0
   nextData.Session=data.SessionToken;nextData.Lease=os.time()+180
   return nextData
  end)
 end)
 locks[player.UserId]=nil
 if profiles[player]~=data or not player.Parent then
  if ok and acquired then
   acquireLock(player.UserId)
   pcall(function() store:UpdateAsync("player_"..player.UserId,function(old)
    if typeof(old)=="table" and old.Session==data.SessionToken then old.Session=nil;old.Lease=0;return old end
    return nil
   end) end)
   locks[player.UserId]=nil
  end
  return
 end
 if ok and not acquired then player:Kick("Tiến trình đang mở ở máy chủ khác. Vui lòng thử lại sau.");return end
 if not ok then
  warn("Evolution load unavailable; temporary session",player.UserId,err)
  data.Loading=false;sync(player,"Chưa tải được DataStore; phiên này chơi thử và không ghi đè dữ liệu cũ.");return
 end
 local normalized=Rules.Normalize(acquired)
 for key,value in pairs(normalized) do data[key]=value end
 data.DropCredits,data.ReceiptIds,data.DropDispatches=metadata(acquired)
 data.NearReviveReadyAt=math.max(0,tonumber(acquired.NearReviveReadyAt) or 0)
 data.Loading=false;data.ReadOnly=false
 local saved=storedVector(acquired.Position)
 if saved and World.IsSafe(saved) then
  local ground=World.GroundPosition(saved)
  data.NextSpawn=ground and CFrame.new(ground+Vector3.new(0,6,0)) or World.StartSpawn
 else data.NextSpawn=World.StartSpawn end
 if teleportCharacter(player,data.NextSpawn) then Character.Apply(player,data);grantProtection(player,Config.SpawnProtectionSeconds) end
 sync(player,"Đã tải tiến trình. Chào mừng đến thế giới mở!")
 task.defer(flushCredits,player)
end
local function playerFromHit(hit)
 local model=hit:FindFirstAncestorOfClass("Model")
 while model do
  local player=Players:GetPlayerFromCharacter(model)
  if player then return player end
  local parent=model.Parent
  model=parent and (parent:IsA("Model") and parent or parent:FindFirstAncestorOfClass("Model"))
 end
end
local function addPlayer(player)
 if profiles[player] then return end
 local data=Rules.DefaultProfile()
 data.Loading=true;data.ReadOnly=true;data.Biome="meadow";data.NextSpawn=World.StartSpawn
 data.DropCredits={};data.ReceiptIds={};data.DropDispatches={};data.QueuedCredits={};data.NearReviveReadyAt=0
 data.SessionToken=serverToken..":"..HttpService:GenerateGUID(false)
 profiles[player]=data
 local stats=player:FindFirstChild("leaderstats") or Instance.new("Folder")
 stats.Name="leaderstats";stats.Parent=player
 for _,name in ipairs({"Coins","Evolution"}) do
  if not stats:FindFirstChild(name) then local v=Instance.new("IntValue");v.Name=name;v.Parent=stats end
 end
 local spawning=false
 local function spawn()
  if spawning or not player.Parent or not profiles[player] then return end
  spawning=true
  local ok,err=pcall(function() player:LoadCharacterAsync() end)
  spawning=false
  if not ok then warn("Evolution spawn failed",player.UserId,err) end
 end
 local function prepare(character)
  local root=character:WaitForChild("HumanoidRootPart",15)
  local humanoid=character:WaitForChild("Humanoid",15)
  if not root or not humanoid or profiles[player]~=data or player.Character~=character then return end
  teleportCharacter(player,data.NextSpawn or World.StartSpawn)
  Character.Apply(player,data)
  grantProtection(player,Config.SpawnProtectionSeconds)
  sync(player)
  local contactConnections={}
  local function attach(part)
   if part.Name~="AnimalCollider" or not part:IsA("BasePart") then return end
   table.insert(contactConnections,part.Touched:Connect(function(hit)
    local other=playerFromHit(hit)
    if other and other~=player then
     recentContacts[player]=recentContacts[player] or {}
     recentContacts[player][other]=os.clock()
    end
   end))
  end
  local collider=character:FindFirstChild("AnimalCollider");if collider then attach(collider) end
  local watcher=character.DescendantAdded:Connect(attach)
  character.AncestryChanged:Connect(function(_,parent)
   if not parent then watcher:Disconnect();for _,c in ipairs(contactConnections) do c:Disconnect() end end
  end)
  humanoid.Died:Connect(function()
   local deathPosition=root.Position
   local biome=World.PositionBiome(deathPosition) or data.Biome or "meadow"
   data.LastDeath={Position=deathPosition,Biome=biome,At=os.time()}
   data.Biome=biome
   data.NextSpawn=World.RandomSpawn(biome,deathPosition,Config.DeathRespawnStuds)
   -- Leaving while dead must resume at the new same-biome spawn as well.
   data.LastPosition=positionRecord(data.NextSpawn.Position,biome)
   sync(player,"Bạn sẽ hồi sinh ở nơi khác cùng biome, cách ít nhất 200 m.")
   task.delay(Players.RespawnTime,function() if player.Character==character then spawn() end end)
  end)
 end
 player.CharacterAdded:Connect(function(character) task.spawn(prepare,character) end)
 player.CharacterAppearanceLoaded:Connect(function(character)
  if player.Character==character and profiles[player]==data then Character.Apply(player,data) end
 end)
 if player.Character then task.spawn(prepare,player.Character) else task.spawn(spawn) end
 sync(player)
 Commerce.OnPlayerAdded(player)
 task.spawn(loadProfile,player)
 task.defer(function() for _,drop in ipairs(Events.GetActiveDrops()) do if player.Parent then remote:FireClient(player,"Drop",drop) end end end)
end
Players.PlayerAdded:Connect(addPlayer)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(addPlayer,player) end
Players.PlayerRemoving:Connect(function(player)
 save(player,true)
 profiles[player]=nil;recentContacts[player]=nil;lastAction[player]=nil;lastAttack[player]=nil
 for _,contacts in pairs(recentContacts) do contacts[player]=nil end
end)
task.spawn(function()
 while true do
  task.wait(60)
  for player in pairs(profiles) do task.spawn(save,player,false);task.spawn(flushCredits,player) end
 end
end)
task.spawn(function()
 while true do
  task.wait(3)
  for player in pairs(profiles) do sync(player) end
 end
end)
game:BindToClose(function()
 local pending=0
 for player in pairs(profiles) do pending+=1;task.spawn(function() save(player,true);pending-=1 end) end
 while pending&gt;0 do task.wait(0.1) end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5476">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">-- Embedded scenery and Rojo both adopt one canonical, seeded open landscape.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Layout = require(Shared.WorldLayout)
local Config = require(Shared.WorldConfig)
local World = {Config = Config, Biomes = {}, BiomeById = {}, MapNodes = {}, Teleports = {}, FoodSpawnPoints = {}, SafeSpawns = {}}
local folder, built = nil, false
local callbacks = {}
local rng = Random.new()
local bridgePass, promptCooldown, entrySide = {}, {}, {}
local obstacleCells, hazards = {}, {}
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
local bridge = Config.Bridge

local function vector(v)
 return Vector3.new(v[1], v[2], v[3])
end

for _, raw in ipairs(Config.Biomes) do
 local biome = table.clone(raw)
 biome.Center = vector(raw.Center)
 table.insert(World.Biomes, biome)
 table.insert(World.MapNodes, biome)
 World.BiomeById[biome.Id] = biome
 World.SafeSpawns[biome.Id] = {}
end
for _, raw in ipairs(Config.SafeSpawns) do
 table.insert(World.SafeSpawns[raw.Biome], vector(raw.Position))
end
for _, raw in ipairs(Config.FoodSpawnPoints) do
 table.insert(World.FoodSpawnPoints, {Position = vector(raw.Position), Biome = raw.Biome})
end
World.StartSpawn = CFrame.new(0, 19, 0)

local function group(parent, name)
 local found = parent:FindFirstChild(name)
 if found then return found end
 local child = Instance.new("Folder")
 child.Name, child.Parent = name, parent
 return child
end

local function billboard(part, spec)
 local gui = Instance.new("BillboardGui")
 gui.Name = "Label"
 gui.Size = UDim2.fromOffset(spec.width, spec.height)
 gui.MaxDistance = spec.width &gt;= 300 and 210 or 90
 gui.LightInfluence = 0
 gui.AlwaysOnTop = false
 gui.Parent = part
 local label = Instance.new("TextLabel")
 label.Name = "Text"
 label.Size = UDim2.fromScale(1, 1)
 label.BackgroundColor3 = Color3.fromRGB(22, 37, 35)
 label.BackgroundTransparency = 0.24
 label.BorderSizePixel = 0
 label.TextColor3 = part.Color
 label.Font = Enum.Font.GothamBold
 label.TextSize = spec.width &gt;= 300 and 24 or 20
 label.TextWrapped = true
 label.Text = spec.title .. (spec.subtitle ~= "" and "\n" .. spec.subtitle or "")
 label.Parent = gui
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, 12)
 corner.Parent = label
end

local function create(parent, record)
 local target = group(parent, record.group)
 local part = target:FindFirstChild(record.name)
 if part then return part end
 part = Instance.new(record.class_name or "Part")
 part.Name = record.name
 part.Size = vector(record.size)
 local rotation = record.rotation or {0, 0, 0}
 part.CFrame = CFrame.new(vector(record.position)) * CFrame.Angles(math.rad(rotation[1]), math.rad(rotation[2]), math.rad(rotation[3]))
 part.Color = Color3.fromRGB(record.color[1], record.color[2], record.color[3])
 part.Anchored = true
 part.CanCollide = record.collide ~= false
 part.CanTouch = record.kind ~= nil
 part.Transparency = record.transparency or 0
 part.Material = Enum.Material[record.material or "SmoothPlastic"]
 part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
 if part:IsA("Part") then part.Shape = Enum.PartType[record.shape or "Block"] end
 if part:IsA("SpawnLocation") then
  part.Neutral, part.Enabled, part.Duration = true, true, 0
 end
 part.Parent = target
 if record.billboard then billboard(part, record.billboard) end
 if record.prompt then
  local prompt = Instance.new("ProximityPrompt")
  prompt.ActionText, prompt.ObjectText = record.prompt.action, record.prompt.object
  prompt.MaxActivationDistance = record.prompt.distance
  prompt.RequiresLineOfSight = false
  prompt.HoldDuration = 0.2
  prompt.Parent = part
 end
 return part
end

function World.PositionBiome(position)
 for _, biome in ipairs(World.Biomes) do
  if position.X &gt;= biome.MinX and position.X &lt;= biome.MaxX and position.Z &gt;= biome.MinZ and position.Z &lt;= biome.MaxZ then
   return biome.Id
  end
 end
 return nil
end
World.BiomeAt = World.PositionBiome

local function footprint(part)
 local half = part.Size / 2
 local right, up, look = part.CFrame.RightVector, part.CFrame.UpVector, part.CFrame.LookVector
 local extentX = math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z
 local extentZ = math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
 return {X = part.Position.X, Z = part.Position.Z, ExtentX = extentX + 4, ExtentZ = extentZ + 4}
end

local function cellKey(x, z)
 return math.floor(x / 128) .. ":" .. math.floor(z / 128)
end

local function indexObstacle(part)
 local box = footprint(part)
 for x = math.floor((box.X - box.ExtentX) / 128), math.floor((box.X + box.ExtentX) / 128) do
  for z = math.floor((box.Z - box.ExtentZ) / 128), math.floor((box.Z + box.ExtentZ) / 128) do
   local key = x .. ":" .. z
   obstacleCells[key] = obstacleCells[key] or {}
   table.insert(obstacleCells[key], box)
  end
 end
end

function World.IsSafe(position)
 if not World.PositionBiome(position) then return false end
 -- Stable exclusions also work before Build, so dependent services can prepare.
 for _, region in ipairs(Config.ProtectedRegions) do
  if position.X &gt; region.MinX - 8 and position.X &lt; region.MaxX + 8 and position.Z &gt; region.MinZ - 8 and position.Z &lt; region.MaxZ + 8 then return false end
 end
 if math.abs(position.X - bridge.X) &lt; bridge.HalfLength + 5 and math.abs(position.Z - bridge.Z) &lt; bridge.HalfWidth + 5 then return false end
 for _, box in ipairs(obstacleCells[cellKey(position.X, position.Z)] or {}) do
  if math.abs(position.X - box.X) &lt; box.ExtentX and math.abs(position.Z - box.Z) &lt; box.ExtentZ then return false end
 end
 return true
end
World.IsSafePosition = World.IsSafe

function World.GroundPosition(first, z)
 local position = typeof(first) == "Vector3" and first or Vector3.new(first, Config.GroundY, z)
 if not World.IsSafe(position) then return nil end
 if built then
  local result = workspace:Raycast(Vector3.new(position.X, 400, position.Z), Vector3.new(0, -450, 0), groundParams)
  if result then return result.Position + Vector3.new(0, 0.1, 0) end
  return nil
 end
 return Vector3.new(position.X, Config.GroundY + 0.1, position.Z)
end

function World.RandomPosition(biomeId, random)
 random = random or rng
 local pool = biomeId and World.SafeSpawns[biomeId]
 if pool then
  return pool[random:NextInteger(1, #pool)]
 end
 local point = World.FoodSpawnPoints[random:NextInteger(1, #World.FoodSpawnPoints)]
 return point.Position
end

function World.GetDropPosition(random)
 random = random or rng
 local point = World.FoodSpawnPoints[random:NextInteger(1, #World.FoodSpawnPoints)]
 return point.Position
end

function World.RandomSpawn(biomeId, avoidPosition, minDistanceStuds)
 local pool = World.SafeSpawns[biomeId] or World.SafeSpawns.meadow
 local minimum = minDistanceStuds or Config.RespawnDistanceStuds
 local candidates, farthest, farthestDistance = {}, nil, -1
 -- Examine the whole biome. A few random retries cannot guarantee the distance.
 for _, point in ipairs(pool) do
  local delta = avoidPosition and point - avoidPosition or Vector3.zero
  local distance = math.sqrt(delta.X * delta.X + delta.Z * delta.Z)
  if not avoidPosition or distance &gt;= minimum then table.insert(candidates, point) end
  if distance &gt; farthestDistance then farthest, farthestDistance = point, distance end
 end
 local selected = #candidates &gt; 0 and candidates[rng:NextInteger(1, #candidates)] or farthest
 assert(selected, "Biome has no safe respawn position")
 return CFrame.new(selected + Vector3.new(0, 6, 0))
end
World.DeathSpawn = World.RandomSpawn

function World.NearestSafeSpawn(biomeId, origin)
 local biome = World.BiomeById[biomeId] or World.BiomeById.meadow
 origin = typeof(origin) == "Vector3" and origin or biome.Center
 local best, bestDistance = nil, math.huge
 local function consider(position)
  if World.PositionBiome(position) ~= biome.Id then return false end
  local delta = position - origin
  local distance = math.sqrt(delta.X * delta.X + delta.Z * delta.Z)
  if distance &gt;= bestDistance then return false end
  local ground = World.GroundPosition(position)
  if not ground then return false end
  best, bestDistance = ground, distance
  return true
 end
 -- A safe death location can be restored exactly. Unsafe water, lava or scenery
 -- use a nearby shore or clearing, never the ordinary distant death spawn.
 consider(origin)
 if not best or bestDistance &gt; 0 then
  for _, point in ipairs(World.SafeSpawns[biome.Id]) do consider(point) end
  -- Refine the guaranteed pool candidate with eight-stud radial steps. Checking
  -- only shorter radii keeps this bounded even when the origin is outside bounds.
  local maximum = math.min(bestDistance, 256)
  for radius = 8, maximum, 8 do
   local found = false
   for step = 0, 15 do
    local angle = step * math.pi / 8
    if consider(origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)) then found = true end
   end
   if found then break end
  end
 end
 assert(best, "Biome has no nearby safe respawn position")
 return CFrame.new(best + Vector3.new(0, 6, 0))
end

local function liveCharacter(player)
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health &lt;= 0 then return nil end
 return character, root, humanoid
end

local function move(player, destination)
 local character, root = liveCharacter(player)
 if not character then return end
 root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
 character:PivotTo(destination)
end

local function validPrompt(player, part)
 local _, root = liveCharacter(player)
 if not root or (root.Position - part.Position).Magnitude &gt; 20 then return false end
 local now = os.clock()
 if promptCooldown[player] and now - promptCooldown[player] &lt; 1 then return false end
 promptCooldown[player] = now
 return true
end

function World.TeleportDestination(sourceId, targetId)
 local ids = Config.Teleports
 if targetId and World.Teleports[targetId] and sourceId ~= targetId then return World.Teleports[targetId] end
 for index, entry in ipairs(ids) do
  if entry.Id == sourceId then return World.Teleports[ids[index % #ids + 1].Id] end
 end
 return nil
end

local function useTeleport(player, sourceId, targetId)
 local source = World.Teleports[sourceId]
 local destination = World.TeleportDestination(sourceId, targetId)
 if not source or not destination or not validPrompt(player, source.Part) then return false end
 if callbacks.OnTeleport and callbacks.OnTeleport(player, sourceId, destination.Id) == true then
  move(player, CFrame.new(destination.Position + Vector3.new(0, 7, 0)))
  return true
 end
 return false
end
function World.UseTeleport(player, targetId)
 local _, root = liveCharacter(player)
 if not root or not World.Teleports[targetId] then return false end
 for sourceId, entry in pairs(World.Teleports) do
  if sourceId ~= targetId and (root.Position - entry.Position).Magnitude &lt;= 20 then
   return useTeleport(player, sourceId, targetId)
  end
 end
 return false
end
World.RequestTeleport = World.UseTeleport

local function useBridge(player, part)
 if not validPrompt(player, part) then return end
 if callbacks.OnBridge and callbacks.OnBridge(player, part, Config.BridgeCost) == true then
  bridgePass[player] = os.clock() + 20
  local side = part:GetAttribute("BridgeSide") or -1
  entrySide[player] = side
  -- The paid crossing carries each buyer safely across; entitlement is per player.
  move(player, CFrame.new(bridge.X - side * 108, Config.GroundY + 7, bridge.Z))
 end
end

function World.Build(receivedCallbacks)
 callbacks = receivedCallbacks or {}
 if built then return folder end
 folder = workspace:FindFirstChild("EvolutionObby")
 if not folder then
  folder = Instance.new("Folder")
  folder.Name, folder.Parent = "EvolutionObby", workspace
 end
 for _, record in ipairs(Layout) do
  local part = create(folder, record)
  part:SetAttribute("Biome", record.biome or World.PositionBiome(part.Position))
  if record.group == "Details" and part.CanCollide then indexObstacle(part) end
  if record.kind == "water" or record.kind == "lava" or record.kind == "swamp" then
   table.insert(hazards, {Part = part, Kind = record.kind})
  elseif record.kind == "spawn" then
   World.StartSpawn = CFrame.new(part.Position + Vector3.new(0, 6, 0))
  elseif record.kind == "teleport" then
   local name = record.id
   for _, definition in ipairs(Config.Teleports) do if definition.Id == record.id then name = definition.Name end end
   World.Teleports[record.id] = {Id = record.id, Name = name, Part = part, Position = part.Position, Biome = record.biome, Cost = record.cost}
   local prompt = part:FindFirstChildOfClass("ProximityPrompt")
   if prompt then prompt.Triggered:Connect(function(player)
    if callbacks.OnTeleportMenu then
     local _, root = liveCharacter(player)
     if not root or (root.Position - part.Position).Magnitude &gt; 20 then return end
     local destinations = {}
     for _, destination in ipairs(Config.Teleports) do
      if destination.Id ~= record.id then
       table.insert(destinations, {Id = destination.Id, Name = destination.Name, Biome = destination.Biome, Cost = destination.Cost})
      end
     end
     callbacks.OnTeleportMenu(player, record.id, destinations)
    else
     useTeleport(player, record.id)
    end
   end) end
  elseif record.kind == "bridge_toll" then
   part:SetAttribute("BridgeSide", record.side)
   local prompt = part:FindFirstChildOfClass("ProximityPrompt")
   if prompt then prompt.Triggered:Connect(function(player) useBridge(player, part) end) end
  end
 end
 groundParams.FilterDescendantsInstances = {folder:FindFirstChild("GroundTerrain")}
 built = true
 workspace:SetAttribute("EvolutionWorldSeed", Config.Seed)
 workspace:SetAttribute("EvolutionWorldReady", true)
 local accumulator = 0
 RunService.Heartbeat:Connect(function(dt)
  accumulator += dt
  if accumulator &lt; 0.12 then return end
  accumulator = 0
  for _, player in ipairs(Players:GetPlayers()) do
   local character, root, humanoid = liveCharacter(player)
   if character then
    local position = root.Position
    local biome = World.PositionBiome(position)
    if biome then character:SetAttribute("Biome", biome) end
    if position.Y &lt; -25 then humanoid.Health = 0 end
    for _, hazard in ipairs(hazards) do
     local part = hazard.Part
     local p = part.CFrame:PointToObjectSpace(position)
     local half = part.Size / 2
     if math.abs(p.X) &lt; half.X and math.abs(p.Z) &lt; half.Z then
      if hazard.Kind == "water" and position.Y &lt; part.Position.Y + half.Y + 1.2 then
       humanoid.Health = 0
      elseif hazard.Kind == "lava" and math.abs(p.Y) &lt; half.Y + 3 then
       local form = character:GetAttribute("Form")
       if form ~= 14 and form ~= 15 then humanoid.Health = 0 end
      elseif hazard.Kind == "swamp" and position.Y &lt; part.Position.Y + 4 then
       -- Marsh water slows traversal without turning every puddle into a death trap.
       local velocity = root.AssemblyLinearVelocity
       root.AssemblyLinearVelocity = Vector3.new(velocity.X * .65, velocity.Y, velocity.Z * .65)
      end
     end
    end
    local dx, dz = position.X - bridge.X, position.Z - bridge.Z
    if math.abs(dz) &lt; bridge.HalfWidth + 3 and math.abs(dx) &lt; bridge.HalfLength and position.Y &lt; 24 then
     if not bridgePass[player] or bridgePass[player] &lt; os.clock() then
      local side = entrySide[player] or (dx &lt; 0 and -1 or 1)
      move(player, CFrame.new(bridge.X + side * 110, Config.GroundY + 7, bridge.Z))
     end
    elseif math.abs(dx) &gt;= bridge.HalfLength and math.abs(dz) &lt; 45 then
     entrySide[player] = dx &lt; 0 and -1 or 1
    end
   end
  end
 end)
 Players.PlayerRemoving:Connect(function(player)
  bridgePass[player], promptCooldown[player], entrySide[player] = nil, nil, nil
 end)
 return folder
end

return World
</ProtectedString>
