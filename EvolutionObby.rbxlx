  <Item class="StarterPlayer" referent="RBX5462">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">5</float>
      <float name="CameraMaxZoomDistance">58</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX5463">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
