 {Id="fish",Name="Cá",Hunger=5,Coins=22,Weight=11},
 {Id="meat",Name="Thịt",Hunger=7,Coins=30,Weight=8},
 {Id="fruit",Name="Trái cây quý",Hunger=10,Coins=45,Weight=4},
}
-- The remaining 75% is Normal. A supply drop triples each non-Normal
-- probability exactly (8/7/7/3 -&gt; 24/21/21/9), leaving 25% Normal.
Config.RareFoodMutations = {
 {Name="Normal",Weight=75}, {Name="Giant",Weight=8}, {Name="Tiny",Weight=7},
 {Name="Radioactive",Weight=7}, {Name="Awakened",Weight=3},
}
Config.Species = {}
local rows = {
 {"Snail", "Ốc Sên",12,40}, {"Caterpillar","Sâu Bướm",14,45},
 {"Mouse","Chuột",16,50}, {"Frog","Ếch",16,65}, {"Turtle","Rùa",14,50},
 {"Rabbit","Thỏ",18,60}, {"Cat","Mèo",20,60}, {"Hound","Chó Săn",24,60},
 {"Monkey","Khỉ",22,75}, {"Cheetah","Báo Gấm",35,65},
 {"Kangaroo","Chuột Túi",24,90}, {"Gorilla","Tinh Tinh",20,70},
 {"Pegasus","Ngựa Cánh",35,95}, {"Phoenix","Phượng Hoàng",40,100},
 {"WhiteDragon","Rồng Trắng",50,120},
}
for id, row in ipairs(rows) do
 Config.Species[id] = {ModelName=row[1], Name=row[2], WalkSpeed=row[3], JumpPower=row[4]}
end
Config.Mutations = {
 {Name="Normal", Label="Nguyên bản", Weight=50, Scale=1, Speed=1, Jump=1},
 {Name="Giant", Label="Khổng lồ", Weight=20, Scale=1.5, Speed=1.1, Jump=1.05},
 {Name="Tiny", Label="Tí hon", Weight=15, Scale=0.5, Speed=1.05, Jump=1.1},
 {Name="Radioactive", Label="Phát quang", Weight=10, Scale=1, Speed=1.15, Jump=1.15},
 {Name="Awakened", Label="Thức tỉnh", Weight=5, Scale=1, Speed=1.3, Jump=1.3},
}
function Config.Unlocked(legacyCheckpoint)
 -- Only used to migrate saves from the old obby version.
 return math.clamp(1 + math.floor(legacyCheckpoint / 10), 1, #Config.Species)
end
function Config.Roll(rng)
 local roll = rng:NextInteger(1,100)
 for _, mutation in ipairs(Config.Mutations) do
  roll -= mutation.Weight
  if roll &lt;= 0 then return mutation.Name end
 end
 return "Normal"
end
function Config.Mutation(name)
 for _, mutation in ipairs(Config.Mutations) do
  if mutation.Name == name then return mutation end
 end
 return Config.Mutations[1]
end
return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5466">
        <Properties>
          <string name="Name">EventRules</string>
          <ProtectedString name="Source">-- Pure event and commerce rules shared by server services and validation.
local EventRules = {}

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

function EventRules.DropChance(playerCount)
	if not isFiniteNumber(playerCount) then
		return 0
	end
	return math.clamp(0.05 * math.floor(playerCount), 0, 1)
end

function EventRules.RollDrop(playerCount, rng)
	local chance = EventRules.DropChance(playerCount)
	return chance &gt;= 1 or (chance &gt; 0 and rng:NextNumber() &lt; chance)
end

function EventRules.IsValidMarketplaceId(id)
	return isFiniteNumber(id) and id &gt; 0 and id == math.floor(id)
end

function EventRules.ReceiptDecision(productId, expectedProductId, playerPresent, grantOk)
	if EventRules.IsValidMarketplaceId(productId)
		and EventRules.IsValidMarketplaceId(expectedProductId)
		and productId == expectedProductId
		and playerPresent == true
		and grantOk == true
	then
		return "PurchaseGranted"
	end
	return "NotProcessedYet"
end

function EventRules.PassBenefits(owned)
	local hasPass = owned == true
	return {
		FoodMultiplier = if hasPass then 1.5 else 1,
		CoinMultiplier = if hasPass then 1.5 else 1,
		FreeRerollsPerMeal = if hasPass then 2 else 0,
		NearDeathRespawnCooldown = if hasPass then 180 else 0,
	}
end

return EventRules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5467">
        <Properties>
          <string name="Name">FoodModels</string>
          <ProtectedString name="Source">-- Hand-built food silhouettes, so the game does not depend on private assets.
local FoodModels = {}

local function piece(model, name, size, position, color, shape, material, rotation)
 local part = Instance.new("Part")
 part.Name = name
 part.Size = size
 part.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
 part.Color = color
 part.Shape = shape or Enum.PartType.Ball
 part.Material = material or Enum.Material.SmoothPlastic
 part.Anchored = true
 part.CanCollide = false
 part.CanTouch = false
 part.CanQuery = false
 part.CastShadow = true
 part.Parent = model
 return part
end

local function leaf(model, position, scale, angle, color)
 return piece(model, "Leaf", Vector3.new(1.25, .18, 2.5) * scale, position,
  color or Color3.fromRGB(63, 157, 79), Enum.PartType.Ball, nil,
  CFrame.Angles(0, math.rad(angle or 0), math.rad(18)))
end

local function wedge(model, name, size, position, color, rotation)
 local part = Instance.new("WedgePart")
 part.Name = name
 part.Size = size
 part.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
 part.Color = color
 part.Material = Enum.Material.SmoothPlastic
 part.Anchored = true
 part.CanCollide = false
 part.CanTouch = false
 part.CanQuery = false
 part.Parent = model
 return part
end

local function berry(model)
 for i = 1, 7 do
  local angle = i * math.pi * 2 / 6
  local x, z = math.sin(angle) * .72, math.cos(angle) * .72
  if i == 7 then x, z = 0, 0 end
  local pos = Vector3.new(x, i == 7 and 1.58 or .84, z)
  piece(model, "Berry", Vector3.new(1.05, 1.1, 1.05), pos,
   i % 2 == 0 and Color3.fromRGB(154, 45, 135) or Color3.fromRGB(76, 69, 178))
  piece(model, "Bloom", Vector3.new(.16, .1, .16), pos + Vector3.new(0, .54, 0), Color3.fromRGB(235, 176, 206))
 end
 leaf(model, Vector3.new(-.8, .18, 0), .75, -30)
 leaf(model, Vector3.new(.8, .19, .1), .7, 45)
end

local function apple(model)
 for _, x in ipairs({-.48, .48}) do
  piece(model, "Apple", Vector3.new(1.78, 2.3, 2.18), Vector3.new(x, 1.23, 0), Color3.fromRGB(226, 65, 59))
 end
 piece(model, "AppleBlush", Vector3.new(.68, 1.35, .12), Vector3.new(-.8, 1.38, -.99), Color3.fromRGB(251, 135, 95))
 piece(model, "Stem", Vector3.new(.22, .7, .22), Vector3.new(0, 2.57, 0), Color3.fromRGB(99, 65, 37), Enum.PartType.Cylinder,
  Enum.Material.Wood, CFrame.Angles(0, 0, math.pi / 2 - .18))
 leaf(model, Vector3.new(.5, 2.75, 0), .5, 75)
end

local function mushroom(model)
 piece(model, "Stem", Vector3.new(.94, 2.15, .94), Vector3.new(0, 1.06, 0), Color3.fromRGB(239, 223, 179))
 piece(model, "Gills", Vector3.new(2.78, .24, 2.78), Vector3.new(0, 2.05, 0), Color3.fromRGB(197, 171, 126))
 piece(model, "Cap", Vector3.new(3.4, 1.42, 3.4), Vector3.new(0, 2.44, 0), Color3.fromRGB(194, 80, 69))
 for i = 1, 6 do
  local angle = i * math.pi / 3
  piece(model, "CreamSpot", Vector3.new(.45, .18, .45), Vector3.new(math.cos(angle) * 1.08, 2.96, math.sin(angle) * 1.08), Color3.fromRGB(255, 240, 203))
 end
 piece(model, "CreamSpot", Vector3.new(.7, .14, .7), Vector3.new(0, 3.16, 0), Color3.fromRGB(255, 240, 203))
end

local function fish(model)
 piece(model, "FishBody", Vector3.new(3.75, 1.15, 1.42), Vector3.new(-.25, .77, 0), Color3.fromRGB(80, 159, 184))
 piece(model, "SilverBelly", Vector3.new(2.95, .62, 1.47), Vector3.new(-.45, .5, 0), Color3.fromRGB(186, 219, 220))
 wedge(model, "TailFin", Vector3.new(1.2, .32, 1.65), Vector3.new(2, .7, 0), Color3.fromRGB(39, 119, 148), CFrame.Angles(0, 0, math.pi))
 wedge(model, "DorsalFin", Vector3.new(1.25, .95, .14), Vector3.new(.12, 1.42, 0), Color3.fromRGB(36, 108, 137))
 for _, z in ipairs({-.68, .68}) do
  piece(model, "FishEye", Vector3.new(.35, .35, .09), Vector3.new(-1.45, .86, z), Color3.fromRGB(237, 245, 229))
  piece(model, "Pupil", Vector3.new(.19, .19, .1), Vector3.new(-1.46, .87, z * 1.04), Color3.fromRGB(25, 46, 56))
 end
end

local function meat(model)
 piece(model, "SteakFat", Vector3.new(3.4, .8, 2.5), Vector3.new(0, .55, 0), Color3.fromRGB(246, 210, 187))
 piece(model, "Steak", Vector3.new(2.85, .92, 2.03), Vector3.new(-.16, .68, 0), Color3.fromRGB(185, 73, 72))
 piece(model, "Bone", Vector3.new(2.7, .32, .44), Vector3.new(1.24, .81, 0), Color3.fromRGB(250, 237, 208))
 for _, z in ipairs({-.24, .24}) do
  piece(model, "BoneEnd", Vector3.new(.66, .58, .58), Vector3.new(2.55, .81, z), Color3.fromRGB(250, 237, 208))
 end
 for i = 1, 3 do
  piece(model, "Marbling", Vector3.new(.1, .045, 1.2), Vector3.new(-1.1 + i * .55, 1.13, 0), Color3.fromRGB(235, 164, 144), Enum.PartType.Block,
   nil, CFrame.Angles(0, -.45, 0))
 end
end

local function tropicalFruit(model)
 piece(model, "GoldenFruit", Vector3.new(2.1, 3.05, 2.1), Vector3.new(0, 1.62, 0), Color3.fromRGB(245, 183, 53))
 for row = 1, 3 do
  for i = 1, 6 do
   local a = i * math.pi / 3 + row * .27
   piece(model, "FruitDiamond", Vector3.new(.45, .5, .15), Vector3.new(math.sin(a), .65 + row * .65, math.cos(a)),
    Color3.fromRGB(183, 118, 39), Enum.PartType.Ball, nil, CFrame.Angles(0, a, -.45))
  end
 end
 for i = 1, 5 do
  local a = i * math.pi * 2 / 5
  leaf(model, Vector3.new(math.sin(a) * .45, 3.38, math.cos(a) * .45), .78, math.deg(a), Color3.fromRGB(75, 151, 77))
 end
end

local function mutationFruit(model, boosted)
 local aqua = boosted and Color3.fromRGB(255, 179, 61) or Color3.fromRGB(91, 240, 204)
 local pink = boosted and Color3.fromRGB(245, 72, 164) or Color3.fromRGB(178, 101, 245)
 piece(model, "LuminousFruit", Vector3.new(2.45, 2.8, 2.45), Vector3.new(0, 1.58, 0), aqua, nil, Enum.Material.Neon)
 for i = 1, 6 do
  local a = i * math.pi / 3
  wedge(model, "CrystalPetal", Vector3.new(.65, 1.75, .72), Vector3.new(math.sin(a) * 1.25, .8, math.cos(a) * 1.25), pink,
   CFrame.Angles(0, a, -.3))
  piece(model, "FloatingSeed", Vector3.new(.28, .28, .28), Vector3.new(math.sin(a) * 2, 2.6 + (i % 2) * .4, math.cos(a) * 2), aqua, nil, Enum.Material.Neon)
 end
 local stem = piece(model, "CrystalStem", Vector3.new(.33, 1.2, .33), Vector3.new(0, 3.34, 0), pink, Enum.PartType.Block, Enum.Material.Neon,
  CFrame.Angles(.18, .2, .3))
 local light = Instance.new("PointLight")
 light.Color = aqua
 light.Brightness = 1.6
 light.Range = 17
 light.Shadows = false
 light.Parent = stem
 local attachment = Instance.new("Attachment")
 attachment.Parent = stem
 local particles = Instance.new("ParticleEmitter")
 particles.Color = ColorSequence.new(aqua, pink)
 particles.Rate = 4
 particles.Lifetime = NumberRange.new(1.3, 2)
 particles.Speed = NumberRange.new(.4, 1.2)
 particles.SpreadAngle = Vector2.new(180, 180)
 particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, .2), NumberSequenceKeypoint.new(1, 0)})
 particles.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, .2), NumberSequenceKeypoint.new(1, 1)})
 particles.LightEmission = 1
 particles.Parent = attachment
 -- A restrained vertical beacon makes genuinely rare food discoverable.
 local beacon = piece(model, "RareBeacon", Vector3.new(.26, 22, .26), Vector3.new(0, 12, 0), aqua, Enum.PartType.Block, Enum.Material.Neon)
 beacon.Transparency = .7
 beacon.CastShadow = false
end

function FoodModels.Create(spec, parent, boosted)
 local model = Instance.new("Model")
 model.Name = spec.Id or "Food"
 local root = piece(model, "Root", Vector3.new(5, 5, 5), Vector3.new(0, 2, 0), Color3.new(1, 1, 1), Enum.PartType.Block)
 root.Transparency = 1
 root.CanTouch = true
 root.CanQuery = true
 root.CastShadow = false
 model.PrimaryPart = root
 local id = string.lower(spec.Id or "berries")
 local isMutation = spec.Mutation == true or id == "mutation"
 if isMutation then mutationFruit(model, boosted)
 elseif id == "leaf" then
  for i = 1, 3 do leaf(model, Vector3.new((i - 2) * .35, .25 + i * .1, 0), 1, (i - 2) * 55) end
 elseif id == "apple" then apple(model)
 elseif id == "mushroom" then mushroom(model)
 elseif id == "fish" then fish(model)
 elseif id == "meat" then meat(model)
 elseif id == "fruit" then tropicalFruit(model)
 else berry(model) end
 model:SetAttribute("IsFood", true)
 model:SetAttribute("FoodId", spec.Id or "berries")
 model:SetAttribute("Hunger", spec.Hunger or .5)
 model:SetAttribute("RareFood", isMutation)
 model:SetAttribute("MutationMultiplier", boosted and 3 or 1)
 local caption = Instance.new("BillboardGui")
 caption.Name = "FoodCaption"
 caption.Size = UDim2.fromOffset(170, 46)
 caption.StudsOffset = Vector3.new(0, 3.8, 0)
 caption.AlwaysOnTop = false
 caption.MaxDistance = isMutation and 150 or 75
 caption.Parent = root
 local label = Instance.new("TextLabel")
 label.BackgroundTransparency = 1
 label.Size = UDim2.fromScale(1, 1)
 label.Font = Enum.Font.GothamMedium
 label.TextSize = 13
 label.TextColor3 = isMutation and Color3.fromRGB(159, 255, 231) or Color3.fromRGB(255, 245, 211)
 label.TextStrokeTransparency = .3
 label.Text = (spec.Name or "Thức ăn") .. (boosted and " · ×3 đột biến" or string.format(" · +%g%%", spec.Hunger or .5))
 label.Parent = caption
 model.Parent = parent
 return model
end

return FoodModels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5468">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">-- Server-authoritative progression rules with no Roblox service dependencies.
local Config = if script then require(script.Parent.Config) else require("./Config")
local Rules = {}
local MAX_COINS = 2147483647
local SPECIES_COUNT = #Config.Species
local mutationNames = {"Normal", "Giant", "Tiny", "Radioactive", "Awakened"}
local validMutation = {}
for _, name in ipairs(mutationNames) do validMutation[name] = true end

local function finite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end

local function bounded(value, minimum, maximum, fallback, integer)
	if not finite(value) then return fallback end
	if integer then value = math.floor(value) end
	return math.clamp(value, minimum, maximum)
end

local function positive(value)
	return if finite(value) then math.max(0, value) else 0
end

function Rules.DefaultProfile()
	return {
		Coins = 0, Fullness = 0, Unlocked = 1, Form = 1,
		Mutations = {["1"] = "Normal"}, FreeRerolls = 0, LastMutationBoost = 1,
	}
end

function Rules.Normalize(raw)
	if type(raw) ~= "table" then return Rules.DefaultProfile() end
	local unlocked
	if raw.Unlocked == nil then
		local checkpoint = bounded(raw.Checkpoint, 0, 140, 0, true)
		unlocked = math.clamp(1 + math.floor(checkpoint / 10), 1, SPECIES_COUNT)
	else
		unlocked = bounded(raw.Unlocked, 1, SPECIES_COUNT, 1, true)
	end
	local mutations = {}
	for form = 1, unlocked do
		local name
		if type(raw.Mutations) == "table" then
			name = raw.Mutations[tostring(form)] or raw.Mutations[form]
		end
		mutations[tostring(form)] = if type(name) == "string" and validMutation[name] then name else "Normal"
	end
	return {
		Coins = bounded(raw.Coins, 0, MAX_COINS, 0, true),
		Fullness = bounded(raw.Fullness, 0, 100, 0, false),
		Unlocked = unlocked,
		Form = bounded(raw.Form, 1, unlocked, 1, true),
		Mutations = mutations,
		FreeRerolls = bounded(raw.FreeRerolls, 0, 2, 0, true),
		LastMutationBoost = if raw.LastMutationBoost == 3 then 3 else 1,
	}
end

function Rules.FullnessGain(base, hasPass)
	return positive(base) * (if hasPass == true then 1.5 else 1)
end

function Rules.CoinsGain(base, hasPass)
	return math.min(MAX_COINS, math.floor(positive(base) * (if hasPass == true then 1.5 else 1) + 0.5))
end

function Rules.AddFood(profile, spec, hasPass)
	local oldFullness = bounded(profile.Fullness, 0, 100, 0, false)
	local oldCoins = bounded(profile.Coins, 0, MAX_COINS, 0, true)
	local food = if type(spec) == "table" then spec else {}
	local base = if food.Hunger ~= nil then food.Hunger else food.Fullness
	profile.Fullness = math.min(100, oldFullness + Rules.FullnessGain(base, hasPass))
	profile.Coins = math.min(MAX_COINS, oldCoins + Rules.CoinsGain(food.Coins, hasPass))
	return profile.Fullness - oldFullness, profile.Coins - oldCoins
end

function Rules.CanEvolve(profile)
	return type(profile) == "table"
		and finite(profile.Unlocked) and profile.Unlocked &gt;= 1 and profile.Unlocked &lt; SPECIES_COUNT
		and finite(profile.Fullness) and profile.Fullness &gt;= 100
end

function Rules.Evolve(profile)
	if not Rules.CanEvolve(profile) then return false end
	profile.Unlocked = math.floor(profile.Unlocked) + 1
	profile.Form = profile.Unlocked
	profile.Fullness = 0
	profile.Mutations[tostring(profile.Unlocked)] = "Normal"
	-- Free rolls belong to the last rare meal and must not transfer to a new species.
	profile.FreeRerolls = 0
	profile.LastMutationBoost = 1
	return true
end

function Rules.MutationWeights(boost)
	local factor = if boost == 3 then 3 else 1
	local baseWeights = {Normal = 75, Giant = 8, Tiny = 7, Radioactive = 7, Awakened = 3}
	for _, row in ipairs(Config.RareFoodMutations or {}) do
		if validMutation[row.Name] and finite(row.Weight) and row.Weight &gt;= 0 then
			baseWeights[row.Name] = row.Weight
		end
	end
	local nonNormal = 0
	for index = 2, #mutationNames do nonNormal += baseWeights[mutationNames[index]] * factor end
	assert(nonNormal &lt;= 100, "Rare-food mutation weights must fit within 100 percent")
	local result = {{Name = "Normal", Weight = 100 - nonNormal}}
	for index = 2, #mutationNames do
		local name = mutationNames[index]
		table.insert(result, {Name = name, Weight = baseWeights[name] * factor})
	end
	return result
end

function Rules.RollMutation(rng, boost)
	local roll = rng:NextInteger(1, 100)
	for _, row in ipairs(Rules.MutationWeights(boost)) do
		roll -= row.Weight
		if roll &lt;= 0 then return row.Name end
	end
	return "Normal"
end

function Rules.StartMutation(profile, rng, boost, hasPass)
	local factor = if boost == 3 then 3 else 1
	local name = Rules.RollMutation(rng, factor)
	profile.Mutations[tostring(profile.Form)] = name
	profile.FreeRerolls = if hasPass == true then 2 else 0
	profile.LastMutationBoost = factor
	return name
end

function Rules.Reroll(profile, rng)
	if not finite(profile.FreeRerolls) or profile.FreeRerolls &lt; 1 then return nil end
	profile.FreeRerolls -= 1
	local name = Rules.RollMutation(rng, profile.LastMutationBoost)
	profile.Mutations[tostring(profile.Form)] = name
	return name
end

function Rules.CanEatNPC(form, preyForm, predatorVolume, preyVolume)
	if predatorVolume ~= nil or preyVolume ~= nil then
		return finite(predatorVolume) and finite(preyVolume)
			and predatorVolume &gt; 0 and preyVolume &gt; 0 and predatorVolume &gt; preyVolume
	end
	return finite(form) and finite(preyForm) and form &gt; preyForm
end

function Rules.AttackStrength(form)
	return 18 + bounded(form, 1, SPECIES_COUNT, 1, true) * 4
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5469">
        <Properties>
