            <float name="Transparency">0</float>
            <token name="Material">272</token>
            <token name="TopSurface">0</token>
            <token name="BottomSurface">0</token>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX4094">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX4095">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX4101">
        <Properties>
          <string name="Name">Character</string>
          <ProtectedString name="Source">local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local AnimalModels = require(game.ReplicatedStorage.Shared.AnimalModels)

local Character = {}
local active = {}
local initialized = false

local function disconnect(character)
 local state = active[character]
 if not state then return end
 for _, connection in ipairs(state.Connections) do connection:Disconnect() end
 active[character] = nil
end

function Character.Initialize()
 if not initialized then
  if not PhysicsService:IsCollisionGroupRegistered("EvolutionAvatar") then
   PhysicsService:RegisterCollisionGroup("EvolutionAvatar")
  end
  PhysicsService:CollisionGroupSetCollidable("EvolutionAvatar", "Default", false)
  PhysicsService:CollisionGroupSetCollidable("EvolutionAvatar", "EvolutionAvatar", false)
  initialized = true
 end
 return AnimalModels.EnsureLibrary()
end

local function belongsToAnimal(instance, character)
 local ancestor = instance.Parent
 while ancestor and ancestor ~= character do
  if ancestor:GetAttribute("EvolutionVisual") then return true end
  ancestor = ancestor.Parent
 end
 return false
end

local function hideAvatar(instance, character)
 if instance.Name == "AnimalCollider" or belongsToAnimal(instance, character) then return end
 if instance:IsA("BasePart") then
  instance.Transparency = 1
  instance.CanCollide = false
  instance.CanTouch = false
  instance.CanQuery = false
  -- Humanoid floor sensing uses its root's collision group. The root remains
  -- query-compatible with the map even though it never physically collides.
  instance.CollisionGroup = instance.Name == "HumanoidRootPart" and "Default" or "EvolutionAvatar"
  instance.Massless = instance.Name ~= "HumanoidRootPart"
 elseif instance:IsA("Decal") or instance:IsA("Texture") then
  instance.Transparency = 1
 elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") then
  instance.Enabled = false
 end
end

local function emitter(parent, name, color, rate, speed)
 local attachment = Instance.new("Attachment")
 attachment.Name = name
 attachment.Parent = parent
 local particles = Instance.new("ParticleEmitter")
 particles.Name = name .. "Particles"
 particles.Color = ColorSequence.new(color)
 particles.LightEmission = 0.7
 particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
 particles.Rate = rate
 particles.Lifetime = NumberRange.new(0.35, 0.75)
 particles.Speed = NumberRange.new(speed * 0.4, speed)
 particles.SpreadAngle = Vector2.new(25, 25)
 particles.Size = NumberSequence.new({
  NumberSequenceKeypoint.new(0, 0.25),
  NumberSequenceKeypoint.new(0.35, 0.4),
  NumberSequenceKeypoint.new(1, 0),
 })
 particles.Transparency = NumberSequence.new({
  NumberSequenceKeypoint.new(0, 0.15),
  NumberSequenceKeypoint.new(1, 1),
 })
 particles.Parent = attachment
 return attachment
end

function Character.Apply(player, data)
 local character = player.Character
 if not character then return false end
 local humanoid = character:FindFirstChildOfClass("Humanoid")
 local root = character:FindFirstChild("HumanoidRootPart")
 if not humanoid or not root then return false end
 if not initialized then Character.Initialize() end
 data = data or {}
 local form = math.clamp(math.floor(tonumber(data.Form) or 1), 1, #Config.Species)
 local mutations = typeof(data.Mutations) == "table" and data.Mutations or {}
 local species = Config.Species[form]
 local mutation = Config.Mutation(mutations[tostring(form)])
 local definition = AnimalModels.Definitions[form]

 disconnect(character)
 for _, name in ipairs({"AnimalVisual", "AnimalCollider", "GlideForce", "GlideAttachment", "AuraAttachment"}) do
  local old = character:FindFirstChild(name, true)
  if old then old:Destroy() end
 end

 -- Preserve the Roblox control rig for both R6 and R15. Only the single
 -- collider touches the world; decorative geometry never blocks jumps.
 humanoid.UseJumpPower = true
 humanoid.WalkSpeed = species.WalkSpeed * mutation.Speed
 humanoid.JumpPower = species.JumpPower * mutation.Jump
 humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
 humanoid.AutoRotate = true
 local groundHeight
 if humanoid.RigType == Enum.HumanoidRigType.R6 then
  humanoid.HipHeight = 0
  local leg = character:FindFirstChild("Left Leg")
  groundHeight = root.Size.Y / 2 + (leg and leg.Size.Y or 2)
 else
  humanoid.HipHeight = 2
  groundHeight = root.Size.Y / 2 + humanoid.HipHeight
 end
 for _, instance in ipairs(character:GetDescendants()) do hideAvatar(instance, character) end

 local scale = mutation.Scale
 if form == 5 then scale *= 0.72 end
 scale = math.clamp(scale, 0.3, 1.5)
 local collision = definition.Collider
 local colliderSize = Vector3.new(
  math.clamp(collision[1] * scale, 0.95, 3.8),
  math.clamp(collision[2] * scale, 0.7, 4.1),
  math.clamp(collision[3] * scale, 1.4, 4.4)
 )
 humanoid.CameraOffset = Vector3.new(0, -groundHeight + colliderSize.Y / 2 - 0.5, 0)
 local collider = Instance.new("Part")
 collider.Name = "AnimalCollider"
 collider.Size = colliderSize
 collider.Transparency = 1
 collider.CanCollide = true
 collider.CanTouch = true
 collider.CanQuery = true
 collider.CollisionGroup = "Default"
 collider.Massless = true
 collider.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.35, 0, 1, 1)
 collider.CFrame = root.CFrame * CFrame.new(0, -groundHeight + colliderSize.Y / 2, 0)
 collider.Parent = character
 local colliderWeld = Instance.new("WeldConstraint")
 colliderWeld.Part0 = root
 colliderWeld.Part1 = collider
 colliderWeld.Parent = collider

 local visual = AnimalModels.Create(form)
 visual.Name = "AnimalVisual"
 visual:SetAttribute("EvolutionVisual", true)
 visual:ScaleTo(scale)
 visual:PivotTo(root.CFrame * CFrame.new(0, -groundHeight, 0))
 visual.Parent = character
 local glow = Color3.fromHSV((player.UserId % 360) / 360, 0.8, 1)
 for _, part in ipairs(visual:GetDescendants()) do
  if part:IsA("BasePart") then
   if mutation.Name == "Radioactive" and part.Name ~= "Root"
    and part.Name ~= "Pupil" and part.Name ~= "Eye" and part.Name ~= "Nose" then
    if part.Color.R + part.Color.G + part.Color.B &gt; 1.4 then
     part.Color = part.Color:Lerp(glow, 0.7)
     part.Material = Enum.Material.Neon
    end
   end
   local weld = Instance.new("Motor6D")
   weld.Name = "AnimalJoint"
   weld.Part0 = root
   weld.Part1 = part
   weld.C0 = root.CFrame:ToObjectSpace(part.CFrame)
   weld.Parent = part
   part.Anchored = false
   part.CanCollide = false
   part.CanTouch = false
   part.CanQuery = false
   part.Massless = true
  end
 end

 local nameplate = Instance.new("BillboardGui")
 nameplate.Name = "SpeciesNameplate"
 nameplate.Size = UDim2.fromOffset(240, 44)
 nameplate.StudsOffset = Vector3.new(0, math.max(1.8, visual:GetExtentsSize().Y - groundHeight + 0.9), 0)
 nameplate.MaxDistance = 55
 nameplate.AlwaysOnTop = false
 nameplate.Adornee = root
 nameplate.Parent = visual
 local label = Instance.new("TextLabel")
 label.Size = UDim2.fromScale(1, 1)
 label.BackgroundTransparency = 1
 label.Text = species.Name .. " · " .. mutation.Label
 label.TextColor3 = mutation.Name == "Awakened" and Color3.fromRGB(255, 224, 134) or Color3.fromRGB(255, 255, 255)
 label.TextStrokeTransparency = 0.35
 label.TextStrokeColor3 = Color3.fromRGB(26, 40, 53)
 label.Font = Enum.Font.GothamBold
 label.TextSize = 14
 label.Parent = nameplate

 if form == 14 then
  local tail = visual:FindFirstChild("TailEmber") or visual.PrimaryPart
  emitter(tail, "PhoenixFlame", Color3.fromRGB(255, 174, 45), 17, 1.8)
  local light = Instance.new("PointLight")
  light.Color = Color3.fromRGB(255, 154, 46)
  light.Brightness = 1.1
  light.Range = 9
  light.Parent = tail
 end
 if mutation.Name == "Awakened" then
  emitter(visual.PrimaryPart, "AwakenedAura", Color3.fromRGB(253, 214, 94), 24, 2)
  local highlight = Instance.new("Highlight")
  highlight.Name = "AwakenedOutline"
  highlight.Adornee = visual
  highlight.FillTransparency = 0.9
  highlight.OutlineColor = Color3.fromRGB(255, 216, 94)
  highlight.OutlineTransparency = 0.2
  highlight.DepthMode = Enum.HighlightDepthMode.Occluded
  highlight.Parent = visual
 elseif mutation.Name == "Radioactive" then
  emitter(visual.PrimaryPart, "RadioactiveAura", glow, 10, 1.1)
 end

 local glideForce
 if form &gt;= 13 or mutation.Name == "Awakened" then
  local attachment = Instance.new("Attachment")
  attachment.Name = "GlideAttachment"
  attachment.Parent = root
  glideForce = Instance.new("VectorForce")
  glideForce.Name = "GlideForce"
  glideForce.Attachment0 = attachment
  glideForce.RelativeTo = Enum.ActuatorRelativeTo.World
  glideForce.ApplyAtCenterOfMass = true
  glideForce.Force = Vector3.zero
  glideForce.Parent = root
 end

 local state = {Connections={}}
 active[character] = state
 table.insert(state.Connections, character.DescendantAdded:Connect(function(instance)
  hideAvatar(instance, character)
 end))
 local glideClock = 0
 table.insert(state.Connections, RunService.Heartbeat:Connect(function(dt)
  if character.Parent == nil or humanoid.Health &lt;= 0 then
   if glideForce then glideForce.Force = Vector3.zero end
   return
  end
  glideClock += dt
  if glideClock &lt; 0.1 then return end
  glideClock = 0
  local falling = humanoid:GetState() == Enum.HumanoidStateType.Freefall and root.AssemblyLinearVelocity.Y &lt; -2
  if glideForce then
   glideForce.Force = falling and Vector3.new(0, root.AssemblyMass * workspace.Gravity * 0.28, 0) or Vector3.zero
  end
 end))
 table.insert(state.Connections, character.AncestryChanged:Connect(function(_, parent)
  if not parent then disconnect(character) end
 end))
 character:SetAttribute("Form", form)
 character:SetAttribute("Mutation", mutation.Name)
 character:SetAttribute("MorphReady", true)
 character:SetAttribute("VisualScale", scale)
 return true
end

function Character.Cleanup(character)
 disconnect(character)
end

return Character
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX4102">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Config = require(game.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Character = require(script.Parent:WaitForChild("Character"))
local World = require(script.Parent:WaitForChild("World"))

-- Never let Roblox spawn an avatar above an uninitialized world.
Players.CharacterAutoLoads = false
workspace:SetAttribute("EvolutionStatus", "Starting")
local rng = Random.new()
local profiles, stations, lastAction, saving = {}, {}, {}, {}
local session = HttpService:GenerateGUID(false)
local remote = game.ReplicatedStorage:FindFirstChild("EvolutionEvent") or Instance.new("RemoteEvent")
remote.Name = "EvolutionEvent"
remote.Parent = game.ReplicatedStorage
local store

local function defaultProfile()
 return {Coins=0, Checkpoint=0, Form=1, Mutations={["1"]="Normal"}, Collected={}, Loading=true, ReadOnly=true}
end
local function integer(value, minimum, maximum, fallback)
 if typeof(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
 return math.clamp(math.floor(value), minimum, maximum)
end
local function sync(player, message)
 local data = profiles[player]
 if not data or not player.Parent then return end
 local stats = player:FindFirstChild("leaderstats")
 if stats then
  stats.Coins.Value = data.Coins
  stats.Checkpoint.Value = data.Checkpoint
 end
 remote:FireClient(player, "State", {
  Coins=data.Coins, Checkpoint=data.Checkpoint, Form=data.Form,
  Unlocked=Config.Unlocked(data.Checkpoint), Mutations=table.clone(data.Mutations),
  Message=message, ReadOnly=data.ReadOnly, Loading=data.Loading,
 })
end
local function alive(player)
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health &lt;= 0 then return nil end
 return root, humanoid
end
local function placeCharacter(player)
 local data = profiles[player]
 local root = alive(player)
 if not data or not root then return end
 local destination = World.Checkpoints[data.Checkpoint] or World.Checkpoints[0]
 player.Character:PivotTo(destination)
 root.AssemblyLinearVelocity = Vector3.zero
 root.AssemblyAngularVelocity = Vector3.zero
 Character.Apply(player, data)
 sync(player)
end
local function save(player, release)
 local data = profiles[player]
 if not store or not data or data.ReadOnly or data.Loading then return end
 while saving[player] do task.wait(0.1) end
 -- A concurrent leave/save may have released the profile while we waited.
 if profiles[player] ~= data or data.ReadOnly or data.Loading then return end
 saving[player] = true
 local payload = {
  Coins=data.Coins, Checkpoint=data.Checkpoint, Form=data.Form,
  Mutations=table.clone(data.Mutations), Lease=release and 0 or os.time()+180,
 }
 if not release then payload.Session = data.SessionToken end
 local ok, result = pcall(function()
  return store:UpdateAsync("player_"..player.UserId, function(old)
   if typeof(old) ~= "table" or old.Session ~= data.SessionToken then return nil end
   return payload
  end)
 end)
 saving[player] = nil
 if not ok then
  warn("Evolution save failed for user", player.UserId, result)
  sync(player, "Chưa lưu được tiến trình; máy chủ sẽ thử lại ở lần autosave tiếp theo.")
 elseif not result then
  data.ReadOnly = true
  sync(player, "Mất khóa dữ liệu: phiên này sẽ không ghi đè tiến trình đã lưu.")
 end
end
local function checkpoint(player, stage)
 local data = profiles[player]
 if not data or data.Loading or stage ~= data.Checkpoint+1 then return end
 local root = alive(player)
 local destination = World.Checkpoints[stage]
 if not root or not destination or (root.Position-destination.Position).Magnitude &gt; 24 then return end
 local previous = Config.Unlocked(data.Checkpoint)
 data.Checkpoint = stage
 data.Coins = math.min(2147483647, data.Coins+Config.CheckpointReward)
 local unlocked = Config.Unlocked(stage)
 local message
 if unlocked &gt; previous then
  data.Form = unlocked
  data.Mutations[tostring(unlocked)] = Config.Roll(rng)
  Character.Apply(player, data)
  message = "Tiến hóa! Đã mở "..Config.Species[unlocked].Name
 end
 if stage == 140 then message = "Hoàn thành hành trình! Bạn đã mở khóa Rồng Trắng." end
 sync(player, message)
end

-- Map, spawn and prompts are always available, even without an online DataStore.
if Character.Initialize then Character.Initialize() end
World.Build(checkpoint, function(player, id, value, coin)
 local data = profiles[player]
 if not data or data.Loading or data.Collected[id] then return end
 local root = alive(player)
 local position = coin and coin.Position or (World.CoinPositions and World.CoinPositions[id])
 if not root or not position or (root.Position-position).Magnitude &gt; 12 then return end
 local stage = coin and coin:GetAttribute("Stage")
 if stage and math.abs(stage-data.Checkpoint)&gt;1 then return end
 data.Collected[id] = true
 data.Coins = math.min(2147483647, data.Coins+value)
 remote:FireClient(player, "Coin", id)
 sync(player, "+"..value.." Coins")
end, function(player, station)
 if profiles[player] then
  stations[player] = station
  remote:FireClient(player, "Station")
 end
end)
workspace:SetAttribute("EvolutionStatus", "Ready")

-- GetDataStore itself can throw in an unpublished place, not just Get/UpdateAsync.
-- Persistence must not be a prerequisite for constructing the world or morphing.
if not (RunService:IsStudio() and game.GameId == 0) then
 local ok, result = pcall(function() return DataStoreService:GetDataStore("EvolutionObby_v1") end)
 if ok then store = result else warn("Evolution DataStore unavailable; using temporary progress", result) end
end
workspace:SetAttribute("EvolutionPersistence", store and "Available" or "Temporary")

remote.OnServerEvent:Connect(function(player, action, value)
 local data = profiles[player]
 if not data then return end
 if typeof(action) ~= "string" then return end
 if lastAction[player] and os.clock()-lastAction[player]&lt;0.35 then return end
 lastAction[player] = os.clock()
 if action == "Sync" then sync(player); return end
 local root = alive(player)
 if not root then return end
 if data.Loading then sync(player, "Đang tải tiến trình. Bạn có thể xem map trong lúc chờ."); return end
 if action == "Morph" then
  if typeof(value) ~= "number" or value ~= value or value%1 ~= 0 or value&lt;1 or value&gt;Config.Unlocked(data.Checkpoint) then return end
  data.Form = value
  Character.Apply(player, data)
  sync(player, "Đã chuyển sang "..Config.Species[value].Name)
 elseif action == "Reroll" then
  local station = stations[player]
  if not station or not station.Parent or (root.Position-station.Position).Magnitude&gt;16 then
   sync(player, "Hãy đến trạm đột biến màu tím."); return
  end
  if data.Coins&lt;Config.RerollCost then sync(player, "Không đủ 500 Coins."); return end
  data.Coins -= Config.RerollCost
  data.Mutations[tostring(data.Form)] = Config.Roll(rng)
  Character.Apply(player, data)
  remote:FireClient(player, "Mutation", data.Mutations[tostring(data.Form)])
  sync(player, "Đột biến: "..Config.Mutation(data.Mutations[tostring(data.Form)]).Label)
 elseif action == "Checkpoint" then
  placeCharacter(player)
 elseif action == "Lobby" then
  player.Character:PivotTo(World.Checkpoints[0])
  root.AssemblyLinearVelocity = Vector3.zero
  root.AssemblyAngularVelocity = Vector3.zero
  sync(player, "Về sảnh. Nút Về checkpoint giúp bạn tiếp tục hành trình.")
 end
end)

local function loadProfile(player)
 local data = profiles[player]
 if not data then return end
 local token = data.SessionToken
 if not store then
  data.Loading = false
  sync(player, "Chế độ chơi thử: map và tiến hóa hoạt động; tiến trình chưa được lưu.")
  return
 end
 local acquired
 local ok, err = pcall(function()
  acquired = store:UpdateAsync("player_"..player.UserId, function(old)
   if typeof(old) == "table" and old.Session and (tonumber(old.Lease) or 0)&gt;os.time() and old.Session ~= token then return nil end
   local nextData = typeof(old) == "table" and table.clone(old) or defaultProfile()
   nextData.Loading=nil; nextData.ReadOnly=nil; nextData.Collected=nil; nextData.SessionToken=nil
   nextData.Session=token; nextData.Lease=os.time()+180
   return nextData
  end)
 end)
 if profiles[player] ~= data or not player.Parent then
  -- Release only the lease acquired by this server if the player left while loading.
  if ok and acquired then
   pcall(function() store:UpdateAsync("player_"..player.UserId, function(old)
    if typeof(old) == "table" and old.Session == token then old.Session=nil; old.Lease=0; return old end
    return nil
   end) end)
  end
  return
 end
 if ok and not acquired then
  player:Kick("Tiến trình đang mở ở máy chủ khác. Vui lòng thử lại sau.")
  return
 end
 if not ok then
  warn("Evolution load unavailable; temporary progress only", player.UserId, err)
  data.Loading = false
  sync(player, "DataStore chưa khả dụng. Bạn vẫn chơi được; phiên này không lưu tiến trình.")
  return
 end
 data.Checkpoint = integer(acquired.Checkpoint,0,140,0)
 data.Coins = integer(acquired.Coins,0,2147483647,0)
 data.Form = integer(acquired.Form,1,Config.Unlocked(data.Checkpoint),1)
 data.Mutations = {}
 for i=1,Config.Unlocked(data.Checkpoint) do
  local name = typeof(acquired.Mutations)=="table" and acquired.Mutations[tostring(i)] or "Normal"
  data.Mutations[tostring(i)] = Config.Mutation(name).Name
 end
 data.Loading=false; data.ReadOnly=false
 placeCharacter(player)
 sync(player, "Đã tải tiến trình. Chào mừng trở lại!")
end

local function addPlayer(player)
 if profiles[player] then return end
 profiles[player] = defaultProfile()
 profiles[player].SessionToken = session..":"..HttpService:GenerateGUID(false)
 local stats = player:FindFirstChild("leaderstats") or Instance.new("Folder")
 stats.Name="leaderstats"; stats.Parent=player
 for _, name in ipairs({"Coins", "Checkpoint"}) do
  if not stats:FindFirstChild(name) then
   local v=Instance.new("IntValue"); v.Name=name; v.Parent=stats
  end
 end
 local spawning = false
 local function requestSpawn()
  if not profiles[player] or not player.Parent or spawning then return end
  spawning = true
  local ok, err = pcall(function() player:LoadCharacterAsync() end)
  spawning = false
  if not ok then warn("Evolution character spawn failed", player.UserId, err) end
 end
 local function prepare(character)
  local root = character:WaitForChild("HumanoidRootPart",15)
  local humanoid = character:WaitForChild("Humanoid",15)
  if not root or not humanoid or not profiles[player] or player.Character ~= character then return end
  placeCharacter(player)
  humanoid.Died:Connect(function()
   task.delay(Players.RespawnTime, function()
    if player.Character==character then requestSpawn() end
   end)
  end)
  -- Accessories can arrive after CharacterAdded; re-hide them after appearance loads.
 end
 player.CharacterAdded:Connect(function(character) task.spawn(prepare,character) end)
 player.CharacterAppearanceLoaded:Connect(function(character)
  if player.Character==character and profiles[player] then Character.Apply(player,profiles[player]) end
 end)
 if player.Character then task.spawn(prepare, player.Character) else task.spawn(requestSpawn) end
 sync(player)
 task.spawn(loadProfile, player)
end
Players.PlayerAdded:Connect(addPlayer)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(addPlayer,player) end
Players.PlayerRemoving:Connect(function(player)
 save(player,true)
 profiles[player]=nil; stations[player]=nil; lastAction[player]=nil
end)
task.spawn(function()
 while true do
  task.wait(60)
  for player in pairs(profiles) do task.spawn(save,player,false) end
 end
end)
game:BindToClose(function()
 local pending = 0
 for player in pairs(profiles) do
  pending += 1
  task.spawn(function() save(player,true); pending-=1 end)
 end
 while pending&gt;0 do task.wait(0.1) end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4103">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">-- Runtime adopts the map embedded in the place. Rojo creates the same geometry.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Layout = require(Shared.WorldLayout)
local AnimalModels = require(Shared.AnimalModels)
local World = {Checkpoints = {}, CoinPositions = {}, CoinStages = {}}
local built = false
local moving, windZones = {}, {}

local function vector(values)
 return Vector3.new(values[1], values[2], values[3])
end

local function group(folder, name)
 local existing = folder:FindFirstChild(name)
 if existing then return existing end
 local result = Instance.new("Folder")
 result.Name = name
 result.Parent = folder
 return result
end

local function billboard(part, spec)
 local gui = Instance.new("BillboardGui")
 gui.Name = "Label"
 gui.Size = UDim2.fromOffset(spec.width, spec.height)
 gui.MaxDistance = spec.width &gt;= 300 and 160 or 65
 gui.LightInfluence = 0
 gui.AlwaysOnTop = false
 gui.Parent = part
 local label = Instance.new("TextLabel")
 label.Name = "Text"
 label.Size = UDim2.fromScale(1, 1)
 label.BackgroundColor3 = Color3.fromRGB(23, 34, 52)
 label.BackgroundTransparency = 0.18
 label.BorderSizePixel = 0
 label.TextColor3 = part.Color
 label.Font = Enum.Font.GothamBold
 label.TextSize = spec.width &gt;= 300 and 25 or 20
 label.TextWrapped = true
 label.Text = spec.title .. (spec.subtitle ~= "" and "\n" .. spec.subtitle or "")
 label.Parent = gui
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, 10)
 corner.Parent = label
end

local function create(folder, record)
 local parent = group(folder, record.group)
 local part = parent:FindFirstChild(record.name)
 if part then return part end
 part = Instance.new(record.class_name or "Part")
 part.Name = record.name
 part.Size = vector(record.size)
 local rotation = record.rotation or {0, 0, 0}
 part.CFrame = CFrame.new(vector(record.position)) * CFrame.Angles(math.rad(rotation[1]), math.rad(rotation[2]), math.rad(rotation[3]))
 part.Color = Color3.fromRGB(record.color[1], record.color[2], record.color[3])
 part.Anchored = true
 part.CanCollide = record.collide ~= false
 part.CanTouch = record.kind ~= nil
 part.Transparency = record.transparency or 0
 part.Material = Enum.Material[record.material or "SmoothPlastic"]
 part.TopSurface = Enum.SurfaceType.Smooth
 part.BottomSurface = Enum.SurfaceType.Smooth
 if part:IsA("Part") then part.Shape = Enum.PartType[record.shape or "Block"] end
 if part:IsA("SpawnLocation") then
  part.Neutral = true
  part.Enabled = true
  part.Duration = 0
 end
 part.Parent = parent
 if record.billboard then billboard(part, record.billboard) end
 if record.prompt then
  local prompt = Instance.new("ProximityPrompt")
  prompt.ActionText = record.prompt.action
  prompt.ObjectText = record.prompt.object
  prompt.MaxActivationDistance = record.prompt.distance
  prompt.RequiresLineOfSight = false
  prompt.HoldDuration = 0
  prompt.Parent = part
 end
 return part
end

-- Find the actual avatar, including hits from its welded animal visual parts.
local function playerFromHit(hit)
 local model = hit:FindFirstAncestorOfClass("Model")
 while model do
  local player = Players:GetPlayerFromCharacter(model)
  if player then return player end
  local parent = model.Parent
  model = parent and (parent:IsA("Model") and parent or parent:FindFirstAncestorOfClass("Model"))
 end
 return nil
end

function World.ReturnToCheckpoint(player)
 local stats = player:FindFirstChild("leaderstats")
 local checkpoint = stats and stats:FindFirstChild("Checkpoint")
 local destination = World.Checkpoints[checkpoint and checkpoint.Value or 0]
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 if root and destination then
  root.AssemblyLinearVelocity = Vector3.zero
  root.AssemblyAngularVelocity = Vector3.zero
  character:PivotTo(destination)
 end
end

local function contains(part, position, padding)
 local localPosition = part.CFrame:PointToObjectSpace(position)
 local half = part.Size / 2 + (padding or Vector3.zero)
 return math.abs(localPosition.X) &lt;= half.X and math.abs(localPosition.Y) &lt;= half.Y and math.abs(localPosition.Z) &lt;= half.Z
end

-- CFrame animation cannot rely solely on Touched: a moving anchored wall also
-- checks its occupied volume so standing avatars are hit consistently.
local function startEnvironmentMotion()
 local started = os.clock()
 RunService.Heartbeat:Connect(function(deltaTime)
  local elapsed = os.clock() - started
  for _, entry in ipairs(moving) do
   local motion = entry.Motion
   local duration = motion.distance / motion.speed
   local cycle = duration + motion.pause
   local phase = elapsed % cycle
   -- Pause at the starting line, then sweep forward at a constant studs/second.
   local distance = phase &lt; motion.pause and 0 or math.min(motion.distance, (phase - motion.pause) * motion.speed)
   local offset = motion.axis == "X" and Vector3.new(distance, 0, 0) or Vector3.new(0, 0, distance)
   entry.Part.CFrame = entry.Origin + offset
  end
  for _, player in ipairs(Players:GetPlayers()) do
   local character = player.Character
   local root = character and character:FindFirstChild("HumanoidRootPart")
   local humanoid = character and character:FindFirstChildOfClass("Humanoid")
   if root and humanoid and humanoid.Health &gt; 0 then
    local form = character:GetAttribute("Form")
    for _, entry in ipairs(moving) do
     if form ~= entry.ImmuneForm and contains(entry.Part, root.Position, Vector3.new(1, 2, 1)) then humanoid.Health = 0 end
    end
    for _, entry in ipairs(windZones) do
     if form ~= entry.ImmuneForm and contains(entry.Part, root.Position) then
      local velocity = root.AssemblyLinearVelocity
      root.AssemblyLinearVelocity = Vector3.new(velocity.X, velocity.Y,
       math.min(entry.Config.max_speed, velocity.Z + entry.Config.acceleration * math.min(deltaTime, 0.1)))
     end
    end
   end
  end
 end)
end

function World.Build(onCheckpoint, onCoin, onStation)
 local folder = workspace:FindFirstChild("EvolutionObby")
 if not folder then
  folder = Instance.new("Folder")
  folder.Name = "EvolutionObby"
  folder.Parent = workspace
 end
 if built then return folder end
 built = true
 for _, record in ipairs(Layout) do
  local part = create(folder, record)
  if record.motion then
   table.insert(moving, {Part = part, Origin = part.CFrame, Motion = record.motion, ImmuneForm = record.immune_form or 14})
  end
  if record.kind == "spawn" then
   local position = part.Position + Vector3.new(0, 5, 0)
   World.Checkpoints[0] = CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
  elseif record.kind == "checkpoint" then
   local stage = record.stage
   local position = part.Position + Vector3.new(0, 5, 0)
   World.Checkpoints[stage] = CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
   part.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if player then onCheckpoint(player, stage) end
   end)
  elseif record.kind == "coin" then
   local id = record.id
   World.CoinPositions[id] = part.Position
   World.CoinStages[id] = record.stage or id
   part:SetAttribute("CoinId", id)
   part:SetAttribute("Stage", record.stage or id)
   part.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    if player then onCoin(player, id, record.value, part) end
   end)
  elseif record.kind == "station" then
   local prompt = part:FindFirstChildOfClass("ProximityPrompt")
   if prompt then prompt.Triggered:Connect(function(player) onStation(player, part) end) end
  elseif record.kind == "return" then
   local prompt = part:FindFirstChildOfClass("ProximityPrompt")
   if prompt then prompt.Triggered:Connect(World.ReturnToCheckpoint) end
  elseif record.kind == "wind" then
   table.insert(windZones, {Part = part, Config = record.wind, ImmuneForm = record.immune_form})
  elseif record.kind == "hazard" or record.kind == "void" then
   part.Touched:Connect(function(hit)
    local player = playerFromHit(hit)
    local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local immune = record.kind == "hazard" and player and player.Character:GetAttribute("Form") == (record.immune_form or 14)
    if humanoid and not immune then humanoid.Health = 0 end
   end)
  end
 end
 -- Rojo users receive the same lobby exhibits as the prebuilt place.
 local exhibits = group(folder, "Exhibits")
 if not exhibits:FindFirstChild("AnimalGallery") then
  local gallery = group(exhibits, "AnimalGallery")
  for form, definition in ipairs(AnimalModels.Definitions) do
   local model = AnimalModels.Create(form, gallery)
   model.Name = string.format("%02d_%s", form, definition.Name)
   model:ScaleTo(0.72)
   local index = form - 1
   model:PivotTo(CFrame.new(-44 + (index % 5) * 12, 11.3, -28 - math.floor(index / 5) * 16))
  end
 end
 startEnvironmentMotion()
 workspace:SetAttribute("EvolutionWorldReady", true)
 return folder
end

return World
