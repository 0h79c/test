  <Item class="StarterPlayer" referent="RBX4096">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">6</float>
      <float name="CameraMaxZoomDistance">36</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX4097">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
