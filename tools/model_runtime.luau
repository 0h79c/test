-- Generated by tools/model_assets.py; edit canonical geometry/template there.
-- Fifteen original creatures; no marketplace mesh or texture dependencies.
local AnimalModels = {}
local ZERO = Vector3.new(0,0,0)
AnimalModels.Definitions = {
@@DEFINITIONS@@
}
AnimalModels.Variants = {
@@VARIANTS@@
}

AnimalModels.Palettes = {
 Normal = {Body=Color3.fromRGB(230,220,200), Accent=Color3.fromRGB(215,175,112), Light=Color3.fromRGB(242,237,220), Dark=Color3.fromRGB(83,72,67)},
 Giant = {Body=Color3.fromRGB(82,142,151), Accent=Color3.fromRGB(226,171,92), Light=Color3.fromRGB(177,213,194), Dark=Color3.fromRGB(45,83,102), Aura=Color3.fromRGB(241,188,100)},
 Tiny = {Body=Color3.fromRGB(174,158,220), Accent=Color3.fromRGB(233,176,211), Light=Color3.fromRGB(224,233,251), Dark=Color3.fromRGB(99,95,155), Aura=Color3.fromRGB(214,174,250)},
 Radioactive = {Body=Color3.fromRGB(52,102,114), Accent=Color3.fromRGB(83,231,192), Light=Color3.fromRGB(146,235,199), Dark=Color3.fromRGB(29,62,80), Aura=Color3.fromRGB(82,245,193)},
 Awakened = {Body=Color3.fromRGB(231,239,233), Accent=Color3.fromRGB(229,192,116), Light=Color3.fromRGB(169,222,218), Dark=Color3.fromRGB(62,123,142), Aura=Color3.fromRGB(249,215,143)},
}

local function createPart(description, model)
 local part = Instance.new(description.class_name)
 part.Name = description.name
 part.Size = Vector3.new(table.unpack(description.size))
 local rotation = description.rotation
 part.CFrame = CFrame.new(table.unpack(description.position))
  * CFrame.Angles(math.rad(rotation[1]), math.rad(rotation[2]), math.rad(rotation[3]))
 part.Color = Color3.fromRGB(table.unpack(description.color))
 part.Material = Enum.Material[description.material]
 part.Transparency = description.transparency or 0
 if part:IsA("Part") then part.Shape = Enum.PartType[description.shape] end
 part.Anchored = true
 part.CanCollide = false
 part.CanTouch = false
 part.CanQuery = false
 part.Massless = true
 part.CastShadow = description.material ~= "Neon"
 part:SetAttribute("BaseColor", part.Color)
 part:SetAttribute("BaseMaterial", description.material)
 part:SetAttribute("SkinRole", description.skin or "Body")
 if description.motion ~= "" then
  part:SetAttribute("Motion", description.motion)
  part:SetAttribute("Phase", description.phase)
 end
 if description.pivot then part:SetAttribute("MotionPivot", Vector3.new(table.unpack(description.pivot))) end
 if description.body_pivot then part:SetAttribute("BodyPivot",Vector3.new(table.unpack(description.body_pivot))) end
 if description.knee then
  part:SetAttribute("KneePivot",Vector3.new(table.unpack(description.knee)))
  part:SetAttribute("LegSide",description.leg_side)
  part:SetAttribute("LegFront",description.leg_front)
  part:SetAttribute("LegLower",description.leg_lower)
 end
 part.Parent = model
 return part
end

function AnimalModels.Create(form, parent)
 form = math.clamp(math.floor(tonumber(form) or 1), 1, #AnimalModels.Definitions)
 local definition = AnimalModels.Definitions[form]
 local model = Instance.new("Model")
 model.Name = definition.Name
 model:SetAttribute("SpeciesForm", form)
 local root = Instance.new("Part")
 root.Name = "Root"
 root.Size = Vector3.new(0.2, 0.2, 0.2)
 root.Transparency = 1
 root.Anchored = true
 root.CanCollide = false
 root.CanTouch = false
 root.CanQuery = false
 root.CastShadow = false
 root.Parent = model
 model.PrimaryPart = root
 for _, description in ipairs(definition.Parts) do createPart(description,model) end
 model.Parent = parent
 return model
end

-- Use a fresh unscaled model for skins/ViewportFrames. This function is also
-- repeatable on an unscaled model; rerolls never stack extra anatomy.
function AnimalModels.ApplySkin(model, form, mutationName)
 form = form or model:GetAttribute("SpeciesForm") or 1
 local palette = AnimalModels.Palettes[mutationName] or AnimalModels.Palettes.Normal
 for _, part in ipairs(model:GetChildren()) do
  if part:GetAttribute("MutationGeometry") then
   part:Destroy()
  elseif part:IsA("BasePart") and part.Name ~= "Root" then
   local base = part:GetAttribute("BaseColor") or part.Color
   local role = part:GetAttribute("SkinRole") or "Body"
   part.Material = Enum.Material[part:GetAttribute("BaseMaterial") or "SmoothPlastic"]
   part.Color = base
   if mutationName ~= "Normal" and palette[role] then
    part.Color = base:Lerp(palette[role], mutationName == "Awakened" and 0.88 or 0.8)
   end
   if mutationName == "Awakened" and role == "Accent" then part.Material = Enum.Material.Metal end
  end
 end
 local definition = AnimalModels.Variants[form]
 local descriptions = definition and definition[mutationName]
 if descriptions then
  for _, description in ipairs(descriptions) do
   local part = createPart(description,model)
   part:SetAttribute("MutationGeometry", true)
  end
 end
 model:SetAttribute("Mutation", mutationName or "Normal")
 return palette
end

-- The same joint description is used immediately after rigging and after a
-- streaming client rediscovers the rig. Authored offsets stay in model space.
function AnimalModels.DescribeJoint(joint)
 local part = joint.Part1
 local pivot = part:GetAttribute("MotionPivot") or ZERO
 return {
  Joint=joint, Motion=part:GetAttribute("Motion") or "Body", Phase=part:GetAttribute("Phase") or 0,
  Pivot=pivot, BodyPivot=part:GetAttribute("BodyPivot") or pivot,
  Knee=part:GetAttribute("KneePivot"), Lower=part:GetAttribute("LegLower") == true,
  Front=part:GetAttribute("LegFront") == true, Side=part:GetAttribute("LegSide") or 1,
 }
end

-- Build after ScaleTo/PivotTo. All connected feathers, feet, face details and
-- tails use common hinge pivots; rotations cannot pull the anatomy apart.
-- The caller may use an anchored NPC root or a Roblox control-rig root.
function AnimalModels.Rig(model, root)
 local modelRoot = model.PrimaryPart
 local scale = model:GetScale()
 local joints = {}
 for _, part in ipairs(model:GetDescendants()) do
  if not part:IsA("BasePart") or part == root then continue end
  local pivot = part:GetAttribute("MotionPivot")
  local hinge = pivot and modelRoot.CFrame * CFrame.new(pivot * scale) or part.CFrame
  local joint = Instance.new("Motor6D")
  joint.Name = "AnimalJoint"
  joint.Part0 = root
  joint.Part1 = part
  joint.C0 = root.CFrame:ToObjectSpace(hinge)
  joint.C1 = part.CFrame:ToObjectSpace(hinge)
  joint.Parent = part
  part.Anchored = false
  part.CanCollide = false
  part.CanTouch = false
  part.CanQuery = false
  part.Massless = true
  table.insert(joints,AnimalModels.DescribeJoint(joint))
 end
 return joints
end

-- Stride is the distance travelled in one full left/right cycle. Cadence
-- increases continuously with real ground speed, including speed potions.
local gaits = {
 {Kind="Crawl",Stride=9,Swing=.10,Bob=.012},
 {Kind="Ripple",Stride=9,Swing=.16,Bob=.02},
 {Kind="Trot",Stride=4.8,Swing=.40,Bob=.045},
 {Kind="Hop",Stride=7,Swing=.53,Bob=.19},
 {Kind="Walk",Stride=6,Swing=.24,Bob=.022},
 {Kind="Bound",Stride=7,Swing=.62,Bob=.18},
 {Kind="Trot",Stride=5.8,Swing=.52,Bob=.06},
 {Kind="Trot",Stride=7,Swing=.62,Bob=.07},
 {Kind="Biped",Stride=6.5,Swing=.49,Bob=.07},
 {Kind="Gallop",Stride=10,Swing=.77,Bob=.105},
 {Kind="Hop",Stride=9,Swing=.68,Bob=.25},
 {Kind="Knuckle",Stride=7,Swing=.38,Bob=.04},
 {Kind="Trot",Stride=9,Swing=.66,Bob=.07},
 {Kind="Biped",Stride=8.5,Swing=.49,Bob=.07},
 {Kind="Walk",Stride=13,Swing=.46,Bob=.045},
}

function AnimalModels.GaitRate(form, speed, scale)
 local gait = gaits[form] or gaits[1]
 return math.max(0,speed) * math.pi * 2 / (gait.Stride * math.max(.2,scale or 1))
end

-- Every limb is a connected two-bone chain, evaluated in the common body
-- frame. Lower legs, paws and claws bend about their shared knee; decorations
-- on the head, tail or a wing all receive precisely the same rigid transform.
function AnimalModels.Animate(joints, clock, phase, moving, falling, scale, form, speed)
 scale = scale or 1
 local profile = gaits[form] or gaits[1]
 local stride = type(moving) == "number" and math.clamp(moving,0,1) or (moving and 1 or 0)
 local kind = profile.Kind
 local hopping = kind == "Hop" or kind == "Bound"
 local breath = math.sin(clock*1.8)*.012*scale
 local hopWave = math.max(0,math.sin(phase))
 local bodyBob = breath*(1-stride) + (hopping and hopWave or -.5+.5*math.cos(phase*2))*profile.Bob*scale*stride
 local pitch = hopping and math.sin(phase)*.075*stride or math.sin(phase*2)*.012*stride
 local roll = (kind == "Walk" or kind == "Knuckle") and math.sin(phase)*.022*stride or 0
 local bodyRotation = CFrame.Angles(pitch,0,roll)
 for _, state in ipairs(joints) do
  local joint = state.Joint
  if not joint.Parent then continue end
  local pivot = state.Pivot or ZERO
  local bodyOffset = ((state.BodyPivot or pivot)-pivot)*scale
  local transform = CFrame.new(0,bodyBob,0)*CFrame.new(bodyOffset)*bodyRotation*CFrame.new(bodyOffset*-1)
  if state.Motion == "Leg" then
   local legPhase = phase + (state.Side == -1 and math.pi or 0) + (state.Front and 0 or math.pi)
   if kind == "Walk" or kind == "Knuckle" then
    -- A four-beat walk staggers the back feet after each front foot.
    legPhase = phase+(state.Side == -1 and math.pi or 0)+(state.Front and 0 or math.pi*.5)
   elseif kind == "Gallop" then
    legPhase = phase+(state.Front and 0 or math.pi*.8)+(state.Side == -1 and .3 or 0)
   elseif hopping then
    legPhase = phase+(state.Front and .8 or 0)
   elseif kind == "Biped" then
    legPhase = phase+(state.Side == -1 and math.pi or 0)+(state.Front and math.pi or 0)
   elseif not state.Knee then
    legPhase = phase+state.Phase*math.pi/2
   end
   local swing = math.sin(legPhase)
   local lift = math.max(0,math.cos(legPhase))
   local amplitude = profile.Swing
   if form == 11 and state.Front then amplitude = amplitude*.3 end
   local hip = swing*amplitude*stride
   -- The foot folds on its return stroke, then extends during contact.
   local knee = lift*(hopping and .95 or .68)*stride
   transform *= CFrame.Angles(hip,0,0)
   if state.Knee and state.Lower then
    local kneeOffset = (state.Knee-pivot)*scale
    transform *= CFrame.new(kneeOffset)*CFrame.Angles(knee,0,0)*CFrame.new(kneeOffset*-1)
   elseif not state.Knee then
    transform *= CFrame.new(0,lift*.035*scale*stride,0)
   end
  elseif state.Motion == "Wing" then
   local flap = math.sin(clock*(falling and 5.8 or 2.3))*(falling and .29 or .045)
   transform *= CFrame.Angles(0,0,(flap-math.sin(phase)*.025*stride)*state.Phase)
  elseif state.Motion == "Tail" then
   transform *= CFrame.Angles(-pitch*.6,math.sin(phase*.5)*.09*stride+math.sin(clock*1.6)*.035,0)
  elseif state.Motion == "Head" then
   transform *= CFrame.Angles(-pitch*.65+math.sin(clock*1.7)*.012,math.sin(clock*.65)*.022*(1-stride),0)
  elseif state.Motion == "Segment" then
   transform *= CFrame.new(0,math.sin(phase+state.Phase*.75)*.027*scale*stride,0)
  elseif state.Motion == "Halo" then
   transform *= CFrame.new(0,math.sin(clock*1.9)*.045*scale,0)*CFrame.Angles(0,clock*.23,0)
  elseif state.Motion == "AuraRing" then
   transform *= CFrame.Angles(0,clock*.3*state.Phase,0)
  end
  joint.Transform = transform
 end
end

function AnimalModels.PopulateLibrary(parent)
 for form, definition in ipairs(AnimalModels.Definitions) do
  if not parent:FindFirstChild(definition.Name) then AnimalModels.Create(form,parent) end
 end
end

function AnimalModels.EnsureLibrary()
 local storage = game:GetService("ReplicatedStorage")
 local folder = storage:FindFirstChild("SpeciesModels")
 if not folder then
  folder = Instance.new("Folder")
  folder.Name = "SpeciesModels"
  folder.Parent = storage
 end
 AnimalModels.PopulateLibrary(folder)
 return folder
end

AnimalModels.Build = AnimalModels.Create
return AnimalModels
